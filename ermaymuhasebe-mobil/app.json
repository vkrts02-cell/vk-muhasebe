{
  "expo": {
    "name": "VK",
    "slug": "vk-muhasebe",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vk.muhasebe",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "192.168.1.103": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "NSCameraUsageDescription": "Fatura ve evrak fotoğrafları eklemek için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Fatura, dekont ve logo yüklemek için galeri erişimi gereklidir.",
        "NSFaceIDUsageDescription": "Güvenli oturum açma ve kilit açma için Face ID kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "16c5ba8b-add7-4c22-a79d-7142c3360086"
      }
    }
  }
}

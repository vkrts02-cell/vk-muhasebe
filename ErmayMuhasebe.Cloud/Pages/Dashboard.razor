@page "/"
@page "/dashboard"
@using ErmayMuhasebe.Shared.ViewModels
@inject DashboardViewModel ViewModel
@inject NavigationManager Navigation
@using ErmayMuhasebe.Cloud.Services
@inject ClientDatabaseService DbService
@inject ErmayMuhasebe.Services.IFirebaseService FirebaseService
@inject IJSRuntime JS

<div class="fade-in d-flex flex-column flex-grow-1 p-0 m-0 overflow-hidden" style="height: 100%;">
    <!-- 1. Quick Actions Row (FIXED GRID - No Wrap) -->
    <div class="dashboard-uniform-grid actions-grid mb-2">
        @foreach (var action in new[] { 
            (Icon: Icons.Material.Outlined.ShoppingCart, Color: "#FB8C00", Title: "Alış", Sub: "Fatura Girişi", Link: "/fatura-olustur/Alis?ReturnUrl=/", BorderColor: "251, 140, 0"),
            (Icon: Icons.Material.Outlined.LocalOffer, Color: "#00C853", Title: "Satış", Sub: "Yeni Satış", Link: "/fatura-olustur/Satis?ReturnUrl=/", BorderColor: "0, 200, 83"),
            (Icon: Icons.Material.Filled.Receipt, Color: "#2196F3", Title: "Sipariş", Sub: "Sipariş Yaz", Link: "/siparis-olustur?ReturnUrl=/", BorderColor: "33, 150, 243"),
            (Icon: Icons.Material.Filled.Percent, Color: "#00B8D4", Title: "Teklif", Sub: "Teklif Hazırla", Link: "/teklif-olustur?ReturnUrl=/", BorderColor: "0, 184, 212"),
            (Icon: Icons.Material.Outlined.Calculate, Color: "#757575", Title: "Maliyet", Sub: "Hesap Makinesi", Link: "/maliyet-hesaplama", BorderColor: "117, 117, 117")
        })
        {
            <div class="dashboard-action-card" @onclick="() => Navigation.NavigateTo(action.Link)" 
                 style="--action-color: @(action.BorderColor);">
                <div class="action-icon-box" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
                    <MudIcon Icon="@action.Icon" Size="Size.Small" Style="color: rgba(255, 255, 255, 0.6);" />
                </div>
                <div class="d-flex flex-column justify-center overflow-hidden">
                    <span class="action-title" style="white-space: nowrap;">@action.Title</span>
                    <span class="action-subtitle" style="white-space: nowrap;">@action.Sub</span>
                </div>
            </div>
        }
    </div>

    <!-- 2. KPI Cards Row (FIXED GRID - No Wrap) -->
    <div class="dashboard-uniform-grid kpi-grid mb-2">
        <div class="kpi-card-premium">
            <div class="kpi-icon-box" style="background: rgba(251, 192, 45, 0.1); border: 1px solid rgba(251, 192, 45, 0.2);">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Style="color: #FBC02D;" />
            </div>
            <div class="kpi-content">
                <span class="kpi-value text-white">@ViewModel.GunlukSatis.ToString("N2") ₺</span>
                <span class="kpi-label">Günlük Ciro</span>
            </div>
        </div>
        <div class="kpi-card-premium">
            <div class="kpi-icon-box" style="background: rgba(33, 150, 243, 0.1); border: 1px solid rgba(33, 150, 243, 0.2);">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Style="color: #2196F3;" />
            </div>
            <div class="kpi-content">
                <span class="kpi-value text-white">@ViewModel.ToplamTahsilat.ToString("N2") ₺</span>
                <span class="kpi-label">Aylık Ciro</span>
            </div>
        </div>
        <div class="kpi-card-premium @(ViewModel.Karlilik >= 0 ? "kpi-profit" : "kpi-loss")">
            <div class="kpi-content">
                <div class="d-flex align-center justify-between w-100">
                    <span class="kpi-value text-white">@ViewModel.Karlilik.ToString("N2") ₺</span>
                    <div class="profit-percent-badge">%@ViewModel.KarlilikOrani.ToString("N1")</div>
                </div>
                <span class="kpi-label" style="color: rgba(255,255,255,0.7);">Net Kâr (Aylık)</span>
            </div>
        </div>
        <div class="kpi-card-premium">
            <div class="kpi-icon-box" style="background: rgba(0, 200, 83, 0.1); border: 1px solid rgba(0, 200, 83, 0.2);">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Style="color: #00C853;" />
            </div>
            <div class="kpi-content">
                <span class="kpi-value text-white">@ViewModel.ToplamAlacak.ToString("N2") ₺</span>
                <span class="kpi-label">Toplam Alacak</span>
            </div>
        </div>
        <div class="kpi-card-premium">
            <div class="kpi-icon-box" style="background: rgba(244, 67, 54, 0.1); border: 1px solid rgba(244, 67, 54, 0.2);">
                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Style="color: #F44336;" />
            </div>
            <div class="kpi-content">
                <span class="kpi-value text-white">@ViewModel.ToplamBorc.ToString("N2") ₺</span>
                <span class="kpi-label">Toplam Borç</span>
            </div>
        </div>
        <div class="kpi-card-premium" style="background: rgba(30, 41, 59, 0.5) !important;">
            <div class="kpi-icon-box" style="background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.2);">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Style="color: #94A3B8;" />
            </div>
            <div class="kpi-content">
                <span class="kpi-value text-white">@ViewModel.StokSayisi</span>
                <span class="kpi-label">Kritik Stok</span>
            </div>
        </div>
    </div>

    <!-- 3. Analytical Section (FIXED FLEX - No Wrap) -->
    <div class="dashboard-main-grid flex-grow-1 overflow-hidden pb-1">
        <div class="analytics-left h-100">
            <div class="dashboard-glass-panel h-100 p-4 d-flex flex-column" style="border-radius: 14px !important;">
                <div class="d-flex justify-content-between align-center mb-6 flex-shrink-0">
                    <div class="panel-title d-flex align-center overflow-hidden" style="font-size: 14px; font-weight: 800; color: white; letter-spacing: 0.3px; line-height: 1;">
                        <MudIcon Icon="@Icons.Material.Filled.Adjust" Style="color: #00C853; font-size: 18px; filter: drop-shadow(0 0 6px rgba(0,200,83,0.4));" class="mr-2" />
                        <span style="white-space: nowrap; transform: translateY(1px);">Hedef & Gerçekleşme</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Style="color: rgba(255,255,255,0.15); transform: translateY(1px);" 
                                       @onclick='() => ViewModel.LoadStatsAsync()' Title="Verileri Yenile" class="ml-1" />
                    </div>
                    <div class="toggle-btn-group flex-shrink-0">
                        <div class="toggle-btn @(ViewModel.IsWeeklyGoal ? "active" : "")" @onclick='() => ViewModel.ToggleGoalPeriodCommand.Execute("Weekly")'>Hafta</div>
                        <div class="toggle-btn @(!ViewModel.IsWeeklyGoal ? "active" : "")" @onclick='() => ViewModel.ToggleGoalPeriodCommand.Execute("Monthly")'>Ay</div>
                    </div>
                </div>
                
                @if (ViewModel.IsLoading)
                {
                    <div class="skeleton flex-grow-1" style="width: 100%; min-height: 220px; border-radius: 12px;"></div>
                }
                else if (!GoalLabels.Any() || (TotalGoalTarget == 0 && TotalGoalActual == 0))
                {
                    <div class="d-flex flex-column align-center justify-center flex-grow-1" style="color: rgba(255,255,255,0.15); min-height: 220px;">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Style="font-size: 54px; margin-bottom: 12px;" />
                        <MudText Typo="Typo.h6" Style="font-size: 14px; opacity: 0.6;">Henüz Hedef Verisi Tanımlanmamış</MudText>
                    </div>
                }
                else
                {
                    <!-- HARMAN MODEL 2: Apple Radial Ring (Sol) + Türkiye Muhasebe Çift Kolon Barları (Sağ) -->
                    <div class="hybrid-chart-wrapper d-flex flex-grow-1 align-center">
                        <!-- SOL PANEL: Apple Radial Progress Ring & Toplamlar -->
                        <div class="apple-ring-card d-flex flex-column align-center justify-center flex-shrink-0">
                            <div class="ring-svg-container position-relative">
                                <svg width="124" height="124" viewBox="0 0 124 124">
                                    <defs>
                                        <linearGradient id="appleRingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="@(GoalCompletionRate >= 100 ? "#34d399" : "#f87171")" />
                                            <stop offset="100%" stop-color="@(GoalCompletionRate >= 100 ? "#10b981" : "#ef4444")" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="62" cy="62" r="46" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="9" />
                                    <circle cx="62" cy="62" r="46" fill="none" stroke="url(#appleRingGrad)" stroke-width="9"
                                            stroke-linecap="round"
                                            stroke-dasharray="289"
                                            stroke-dashoffset="@GoalRingDashOffset"
                                            transform="rotate(-90 62 62)"
                                            style="transition: stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1); filter: drop-shadow(0 0 6px @(GoalCompletionRate >= 100 ? "rgba(16, 185, 129, 0.35)" : "rgba(239, 68, 68, 0.35)"));" />
                                </svg>
                                <div class="ring-center-text d-flex flex-column align-center justify-center">
                                    <span class="ring-pct">@GoalCompletionRate%</span>
                                    <span class="ring-lbl">Tamamlandı</span>
                                </div>
                            </div>
                            
                            <div class="ring-summary-box mt-3 d-flex flex-column">
                                <div class="ring-summary-row d-flex justify-space-between align-center">
                                    <span class="ring-sum-label"><span class="legend-dot dot-green"></span>Hedef:</span>
                                    <span class="ring-sum-val">₺ @TotalGoalTarget.ToString("N0")</span>
                                </div>
                                <div class="ring-summary-row d-flex justify-space-between align-center">
                                    <span class="ring-sum-label"><span class="legend-dot dot-red"></span>Gerçekleşen:</span>
                                    <span class="ring-sum-val val-red">₺ @TotalGoalActual.ToString("N0")</span>
                                </div>
                            </div>
                        </div>

                        <!-- SAĞ PANEL: Türkiye Muhasebe Standardı Çift Kolon Grafiği -->
                        <div class="accounting-bars-card flex-grow-1 d-flex flex-column h-100">
                            <!-- Çizim Alanı (Y-Axis Kılavuzları ve Barlar) -->
                            <div class="bars-drawing-area position-relative flex-grow-1 d-flex">
                                <!-- Y-Axis Etiketleri -->
                                <div class="y-axis-labels d-flex flex-column justify-space-between align-end pr-2 flex-shrink-0">
                                    <span>₺ @FormatShortCurrency(MaxGoalValue)</span>
                                    <span>₺ @FormatShortCurrency(MaxGoalValue * 0.75m)</span>
                                    <span>₺ @FormatShortCurrency(MaxGoalValue * 0.50m)</span>
                                    <span>₺ @FormatShortCurrency(MaxGoalValue * 0.25m)</span>
                                    <span>₺ 0</span>
                                </div>

                                <!-- Barlar ve Izgara Çizgileri -->
                                <div class="bars-plot-area position-relative flex-grow-1">
                                    <!-- Yatay Kılavuz Çizgileri -->
                                    <div class="grid-line" style="top: 0%;"></div>
                                    <div class="grid-line" style="top: 25%;"></div>
                                    <div class="grid-line" style="top: 50%;"></div>
                                    <div class="grid-line" style="top: 75%;"></div>
                                    <div class="grid-line" style="top: 100%;"></div>

                                    <!-- Barların Esnek Dağılımı -->
                                    <div class="bars-columns-wrapper d-flex justify-space-between align-end h-100">
                                        @for (int i = 0; i < GoalLabels.Length; i++)
                                        {
                                            var idx = i;
                                            var lbl = GoalLabels[idx];
                                            var tVal = GoalTargetValues.Length > idx ? GoalTargetValues[idx] : 0m;
                                            var aVal = GoalActualValues.Length > idx ? GoalActualValues[idx] : 0m;
                                            var tHeight = GetBarHeightPercent(tVal);
                                            var aHeight = GetBarHeightPercent(aVal);

                                            <div class="bar-pair-group d-flex flex-column align-center flex-grow-1" 
                                                 title="@($"{lbl} | Hedef: ₺{tVal:N0} | Gerçekleşen: ₺{aVal:N0}")">
                                                <div class="pair-bars-box d-flex align-end gap-1 flex-grow-1">
                                                    <!-- Hedef Bar (Muted Slate) -->
                                                    <div class="bar-col bar-target" style="height: @(tHeight)%;"></div>
                                                    <!-- Gerçekleşen Bar (Apple Canlı Mavi) -->
                                                    <div class="bar-col bar-actual" style="height: @(aHeight)%;"></div>
                                                </div>
                                                <span class="x-axis-lbl mt-2">@lbl</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Legend / Gösterge -->
                            <div class="bars-legend d-flex justify-center align-center gap-5 mt-2 flex-shrink-0">
                                <div class="d-flex align-center gap-1">
                                    <span class="legend-dot dot-green"></span>
                                    <span class="legend-text">Hedef</span>
                                </div>
                                <div class="d-flex align-center gap-1">
                                    <span class="legend-dot dot-red"></span>
                                    <span class="legend-text">Gerçekleşen</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <div class="analytics-right h-100">
            <div class="dashboard-glass-panel h-100 d-flex flex-column" style="border-radius: 14px !important; overflow: hidden;">
                <div class="dashboard-tabs flex-shrink-0" style="padding: 12px 20px 0 20px;">
                    <div class="dashboard-tab @(activeTab == "Son İşlemler" ? "active" : "")" @onclick='() => SetActiveTab("Son İşlemler")'>Son İşlemler</div>
                    <div class="dashboard-tab @(activeTab == "Alacak Takibi" ? "active" : "")" @onclick='() => SetActiveTab("Alacak Takibi")'>Alacak Takibi</div>
                    <div class="dashboard-tab @(activeTab == "Borç Takibi" ? "active" : "")" @onclick='() => SetActiveTab("Borç Takibi")'>Borç Takibi</div>
                    <div class="dashboard-tab @(activeTab == "Notlarım" ? "active" : "")" @onclick='() => SetActiveTab("Notlarım")'>Notlarım</div>
                </div>
                
                <div class="flex-grow-1 px-4 py-2" style="overflow-y: auto;">
                    @if (ViewModel.IsLoading)
                    {
                        @for(int i=0; i<6; i++) { <div class="skeleton mb-4" style="height: 60px; border-radius: 10px;"></div> }
                    }
                    else
                    {
                        @if (activeTab == "Son İşlemler")
                        {
                            @foreach (var item in ViewModel.RecentTransactions.Take(12))
                            {
                                <div class="trans-item py-3">
                                    <div class="trans-info">
                                        <span class="trans-name">@item.Title</span>
                                        <span class="trans-type">@item.Description</span>
                                    </div>
                                    <div class="trans-meta">
                                        <span class="trans-val">@item.Amount.ToString("N2") ₺</span>
                                        <span class="trans-dt">@item.Date.ToString("dd MMM HH:mm")</span>
                                    </div>
                                </div>
                            }
                        }
                        else if (activeTab == "Alacak Takibi")
                        {
                            @foreach (var item in ViewModel.RiskyCaris.Take(12))
                            {
                                <div class="trans-item py-3" @onclick='() => Navigation.NavigateTo($"/cariler?selectId={item.CariId}")' style="cursor: pointer;">
                                    <div class="trans-info">
                                        <span class="trans-name">@item.Unvan</span>
                                        <span class="trans-type">Vade: @item.OrtalamaVade Gün</span>
                                    </div>
                                    <div class="trans-meta">
                                        <span class="trans-val">@item.Bakiye.ToString("N2") ₺</span>
                                        <span class="trans-dt text-danger">Riskli Bakiye</span>
                                    </div>
                                </div>
                            }
                        }
                        else if (activeTab == "Borç Takibi")
                        {
                            @foreach (var item in ViewModel.PayableCaris.Take(12))
                            {
                                <div class="trans-item py-3" @onclick='() => Navigation.NavigateTo($"/cariler?selectId={item.CariId}")' style="cursor: pointer;">
                                    <div class="trans-info">
                                        <span class="trans-name">@item.Unvan</span>
                                        <span class="trans-type">Vade: @item.OrtalamaVade Gün</span>
                                    </div>
                                    <div class="trans-meta">
                                        <span class="trans-val">@item.Bakiye.ToString("N2") ₺</span>
                                        <span class="trans-dt text-warning">Toplam Borç</span>
                                    </div>
                                </div>
                            }
                        }
                        else if (activeTab == "Notlarım")
                        {
                            <QuickNotes RelatedType="General" />
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Responsive Mode Selection Frame -->
    <div class="d-flex justify-content-center flex-shrink-0" style="padding-bottom: 20px; padding-top: 10px;">
        <div class="responsive-selection-frame">
            <button @onclick='() => SetMode("desktop")' class="responsive-btn desktop-btn @(currentMode == "desktop" ? "active" : "")" title="Masaüstü Moduna Geç">
                 <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Style="font-size: 20px;" />
            </button>
            <div class="frame-divider"></div>
            <button @onclick='() => SetMode("mobile")' class="responsive-btn mobile-btn @(currentMode == "mobile" ? "active" : "")" title="Mobil Moduna Geç">
                 <MudIcon Icon="@Icons.Material.Filled.Smartphone" Style="font-size: 20px;" />
            </button>
        </div>
    </div>
</div>

@code {
    private string activeTab = "Son İşlemler";
    private string currentMode = "desktop";
    private string[] Labels => ViewModel.IncomeExpenseData.FirstOrDefault()?.Labels ?? new[] { "Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara" };
    
    private List<ChartSeries> IncomeExpenseSeries => ViewModel.IncomeExpenseData.Select(ds => new ChartSeries 
    { 
        Name = ds.Name, 
        Data = ds.Values.Select(v => (double)v).ToArray() 
    }).ToList();

    private decimal TotalGoalTarget => ViewModel.TargetVsActualData?.FirstOrDefault()?.Values?.Sum() ?? 0m;
    private decimal TotalGoalActual => (ViewModel.TargetVsActualData?.Length > 1 ? ViewModel.TargetVsActualData[1].Values?.Sum() : 0m) ?? 0m;
    private int GoalCompletionRate => TotalGoalTarget > 0 ? (int)Math.Min(999, Math.Round((TotalGoalActual / TotalGoalTarget) * 100m)) : 0;
    
    private double GoalRingDashOffset {
        get {
            const double circ = 289.0;
            if (TotalGoalTarget <= 0) return circ;
            double ratio = Math.Min(1.0, (double)(TotalGoalActual / TotalGoalTarget));
            return circ * (1.0 - ratio);
        }
    }

    private string[] GoalLabels => ViewModel.TargetVsActualData?.FirstOrDefault()?.Labels ?? Array.Empty<string>();
    private decimal[] GoalTargetValues => ViewModel.TargetVsActualData?.FirstOrDefault()?.Values ?? Array.Empty<decimal>();
    private decimal[] GoalActualValues => (ViewModel.TargetVsActualData?.Length > 1 ? ViewModel.TargetVsActualData[1].Values : Array.Empty<decimal>());

    private decimal MaxGoalValue {
        get {
            var maxT = GoalTargetValues.Length > 0 ? GoalTargetValues.Max() : 0m;
            var maxA = GoalActualValues.Length > 0 ? GoalActualValues.Max() : 0m;
            var m = Math.Max(maxT, maxA);
            if (m <= 0) m = 100000m;
            decimal magnitude = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)m)));
            return Math.Ceiling(m / magnitude) * magnitude;
        }
    }

    private double GetBarHeightPercent(decimal val) {
        if (MaxGoalValue <= 0 || val <= 0) return 0;
        double pct = (double)(val / MaxGoalValue) * 100.0;
        return Math.Min(100.0, Math.Max(2.5, pct));
    }

    private string FormatShortCurrency(decimal val) {
        if (val >= 1_000_000) return (val / 1_000_000m).ToString("0.#") + "M";
        if (val >= 1_000) return (val / 1_000m).ToString("0.#") + "K";
        return val.ToString("0");
    }

    private List<ChartSeries> GoalSeries {
        get {
            var rawData = ViewModel.TargetVsActualData?.ToList();
            if (rawData == null || rawData.Count == 0) return new List<ChartSeries>();

            var allValues = rawData.SelectMany(x => x.Values).ToList();
            var max = allValues.Any() ? (double)allValues.Max() : 0;
            if (max <= 0) max = 1;

            return rawData.Select(ds => new ChartSeries 
            { 
                Name = ds.Name, 
                Data = ds.Values.Select(v => (double)v / max * 100.0).ToArray() 
            }).ToList();
        }
    }

    private string[] ProcessedGoalLabels {
        get {
            var data = ViewModel.TargetVsActualData?.ToList();
            if (data == null || data.Count < 1) return new[] { "1.H", "2.H", "3.H", "4.H" };
            var labels = data[0].Labels;
            var result = new string[labels.Length];
            var hasActual = data.Count > 1;
            for(int i=0; i<labels.Length; i++) {
                var t = data[0].Values.Length > i ? data[0].Values[i] : 0;
                var a = hasActual && data[1].Values.Length > i ? data[1].Values[i] : 0;
                result[i] = $"{FormatVal(t)} {FormatVal(a)}\n{labels[i]}";
            }
            return result;
        }
    }

    private string FormatVal(decimal val) {
        if (val == 0) return "0";
        if (val >= 1000000) return (val / 1000000m).ToString("0.#") + "M";
        if (val >= 1000) return (val / 1000m).ToString("0") + "K";
        return val.ToString("0");
    }

    private ChartOptions chartOptions = new ChartOptions
    {
        YAxisLines = true,
        XAxisLines = false,
        YAxisTicks = 5,
        ChartPalette = new[] { "#FF6B00", "#00E676", "#2196F3", "#00B8D4" }
    };

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
        await ViewModel.LoadStatsAsync();
    }

    private async Task ToggleResponsiveMode()
    {
        await JS.InvokeVoidAsync("toggleResponsiveMode");
    }

    private async Task SetMode(string mode)
    {
        currentMode = mode;
        await JS.InvokeVoidAsync("setResponsiveMode", mode);
        StateHasChanged();
    }

    private async Task<IEnumerable<GlobalSearchResult>> SearchGlobalAsync(string value, CancellationToken token)
    {
        try
        {
            return await DbService.GlobalSearchAsync(value);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Global Search Error: {ex}");
            return new List<GlobalSearchResult>();
        }
    }

    private string[] customPalette = new[] { "#FFB300", "#00C853", "#2196F3", "#00B8D4" };

    private void OnSearchResultSelected(GlobalSearchResult? result)
    {
        if (result == null) return;
        switch (result.Type)
        {
            case "Cari": Navigation.NavigateTo($"/cari-detay/{result.Id}"); break;
            case "Stok": Navigation.NavigateTo($"/stok-detay/{result.Id}"); break;
            case "Fatura": Navigation.NavigateTo($"/fatura-detay/{result.Id}"); break;
            case "Siparis": Navigation.NavigateTo($"/siparis-detay/{result.Id}"); break;
        }
    }
}

<style>
    .glass-search .mud-input-control-input-container {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 12px !important;
    }
    .glass-search input {
        color: white !important;
    }
    .glass-search .mud-icon-root {
        color: rgba(255, 255, 255, 0.7) !important;
    }

@page "/raporlar"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Cloud.ViewModels
@inject RaporListViewModel ViewModel
@inject ISnackbar Snackbar

<style>
    /* Desktop Parity Styles for Raporlar */
    .rapor-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        padding-bottom: 40px;
    }

    .rapor-card {
        background: #141619;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        height: 220px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .rapor-card:hover {
        background: #181A1D;
        border-color: rgba(56, 189, 248, 0.3);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .r-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid rgba(56, 189, 248, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(56, 189, 248, 0.7);
        background: transparent;
    }

    .r-title {
        font-size: 16px;
        font-weight: 800;
        color: white;
        margin: 0;
        line-height: 1.2;
    }

    .r-desc {
        color: rgba(255, 255, 255, 0.5);
        font-size: 13px;
        margin-top: 20px;
        line-height: 1.5;
        font-weight: 500;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .r-cat {
        font-size: 11px;
        font-weight: 800;
        color: #38BDF8;
    }

    .r-btn-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: #38BDF8;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        transition: all 0.2s;
    }
    .r-btn-circle:hover {
        background: rgba(56, 189, 248, 0.15);
        border-color: #38BDF8;
    }

    .r-btn-pill {
        height: 32px;
        padding: 0 16px;
        border-radius: 16px;
        border: 1px solid rgba(245, 158, 11, 0.4);
        color: #FBBF24;
        display: flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        font-weight: 800;
        font-size: 10px;
        letter-spacing: 0.5px;
        transition: all 0.2s;
    }
    .r-btn-pill:hover {
        background: rgba(245, 158, 11, 0.15);
        border-color: #FBBF24;
    }

    .r-header-title {
        font-size: 34px;
        font-weight: 900;
        color: #38BDF8;
        margin: 0 0 8px 0;
        letter-spacing: -0.5px;
    }

    .r-header-sub {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 500;
    }

    .r-search-box {
        height: 42px;
        width: 320px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 21px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        background: transparent;
        transition: all 0.3s;
    }

    .r-search-box:focus-within {
        border-color: rgba(255, 255, 255, 0.4);
        background: rgba(255, 255, 255, 0.02);
    }

    .r-search-input {
        background: transparent;
        border: none;
        color: white;
        width: 100%;
        height: 100%;
        outline: none;
        font-size: 13px;
        margin-left: 10px;
    .r-search-input::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .r-generation-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(14, 17, 19, 0.9);
        backdrop-filter: blur(8px);
        z-index: 50;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .r-period-bar {
        background: #111622;
        border: 1px solid #26334D;
        border-radius: 14px;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        flex-shrink: 0;
    }

    .r-btn-period {
        background: #1A2230;
        border: 1px solid #2A384C;
        color: #CBD5E1;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .r-btn-period:hover, .r-btn-period.active {
        background: #2563EB;
        color: white;
        border-color: #3B82F6;
    }

    .r-badge-range {
        background: #182234;
        border: 1px solid #3B82F6;
        border-radius: 8px;
        padding: 8px 16px;
        color: #38BDF8;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="fade-in d-flex flex-grow-1 flex-column rapor-page-container" style="overflow-y: auto; overflow-x: hidden; height: 100%; padding: 40px;">

    <!-- Top Header -->
    <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 28px; flex-shrink: 0;">
        <div>
            <h1 class="r-header-title">Raporlar Merkezi</h1>
            <div class="r-header-sub">İşletme analizlerinizi tek noktadan profesyonelce yönetin.</div>
        </div>
        
        <div>
            <div class="r-search-box">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Style="color: rgba(255,255,255,0.4);" />
                <input type="text" placeholder="Rapor adı ara..." 
                       @bind-value="ViewModel.SearchString" @bind-value:event="oninput" 
                       @onkeyup='(e) => { if(e.Key == "Enter") ViewModel.SearchReports(); }'
                       class="r-search-input" />
            </div>
        </div>
    </div>

    <!-- Date Period Filter Toolbar -->
    <div class="r-period-bar">
        <div style="display: flex; align-items: center; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 6px; background: #1E293B; padding: 6px 12px; border-radius: 8px; margin-right: 6px;">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Style="color: #60A5FA;" />
                <span style="font-size: 13px; font-weight: 700; color: #94A3B8;">Dönem:</span>
            </div>
            <button class="r-btn-period @(ViewModel.SelectedDateFilter == "All" ? "active" : "")" @onclick='() => ViewModel.SetDateFilter("All")'>Tümü</button>
            <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Weekly" ? "active" : "")" @onclick='() => ViewModel.SetDateFilter("Weekly")'>Haftalık</button>
            <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Monthly" ? "active" : "")" @onclick='() => ViewModel.SetDateFilter("Monthly")'>Aylık</button>
            <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Yearly" ? "active" : "")" @onclick='() => ViewModel.SetDateFilter("Yearly")'>Yıllık</button>
            <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Custom" ? "active" : "")" @onclick="ViewModel.OpenDateSelection">
                <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                Özel Tarih...
            </button>
        </div>

        <div class="r-badge-range">
            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
            <span style="font-weight: 500; color: #94A3B8; font-size: 12px;">Seçili Aralık:</span>
            <span>@ViewModel.DateRangeText</span>
        </div>
    </div>

    <!-- Generating Overlay -->
    @if (ViewModel.IsGenerating)
    {
        <div class="r-generation-overlay fade-in">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-6" Style="width: 250px;" />
            <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 8px;">Rapor Paketi Hazırlanıyor...</h3>
            <p style="color: rgba(255,255,255,0.5);">Lütfen bekleyiniz, veriler analiz ediliyor.</p>
        </div>
    }

    <!-- Grid -->
    <div class="rapor-grid">
        @foreach (var report in ViewModel.Reports)
        {
            <div class="rapor-card">
                <div style="display: flex; align-items: center; gap: 16px;">
                    <div class="r-icon-box">
                        <MudIcon Icon="@GetIcon(report.Icon)" Size="Size.Small" />
                    </div>
                    <div class="r-title">@report.Title</div>
                </div>

                <div class="r-desc">@report.Description</div>

                <div style="flex-grow: 1;"></div>

                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="r-cat">@report.Category</div>
                    <div style="display: flex; gap: 8px;">
                        <button class="r-btn-circle" @onclick="() => ViewModel.RunReport(report)" title="Göster">
                            <MudIcon Icon="@Icons.Material.Filled.Launch" Size="Size.Small" />
                        </button>
                        <button class="r-btn-pill" @onclick="() => ViewModel.RunReport(report)" title="Yazdır">
                            <MudIcon Icon="@Icons.Material.Outlined.Print" Size="Size.Small" /> <span>YAZDIR</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!ViewModel.Reports.Any())
    {
        <div style="text-align: center; padding: 60px 0; color: rgba(255,255,255,0.3);">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="margin-bottom: 16px; font-size: 48px;" />
            <div style="font-size: 15px; font-weight: 500;">Aranan kriterlere uygun rapor bulunamadı.</div>
        </div>
    }
</div>

<!-- Cari Selection Overlay -->
@if (ViewModel.IsCariSelectionVisible)
{
    <div class="dialog-overlay-desktop fade-in">
        <div class="dialog-card-desktop glass-morphism">
            <div class="dialog-header-desktop">
                <h3 class="m-0 h5 fw-black">Cari Hesap Seçiniz</h3>
                <button class="dialog-close-btn" @onclick="ViewModel.CloseCariSelection">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>
            
            <div class="pa-6">
                <div class="dialog-search-wrapper mb-6">
                    <input type="text" @bind="ViewModel.CariSearchTerm" @bind:event="oninput" 
                           @onkeyup='(e) => { if(e.Key == "Enter") ViewModel.SearchCariAsync(); }'
                           placeholder="Ünvan veya kod ile ara..." autofocus />
                </div>
                
                <div class="cari-results-scroll shadow-inner">
                    @foreach (var cari in ViewModel.CariSearchResults)
                    {
                        <div class="cari-result-item clickable" @onclick="() => ViewModel.SelectCariAsync(cari)">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex flex-column">
                                    <span class="cari-unvan">@cari.Unvan</span>
                                    <span class="cari-kod">@cari.CariKod</span>
                                </div>
                                <div class="text-end">
                                    <div class="cari-bakiye">@cari.Bakiye.ToString("C2")</div>
                                    <div class="cari-bakiye-label">Bakiye</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            
            <div class="pa-6 pt-0 d-flex justify-content-end">
                <button class="premium-button secondary" @onclick="ViewModel.CloseCariSelection">VAZGEÇ</button>
            </div>
        </div>
    </div>
}

<!-- Date Selection Overlay -->
@if (ViewModel.IsDateSelectionVisible)
{
    <div class="dialog-overlay-desktop fade-in">
        <div class="dialog-card-desktop glass-morphism" style="max-width: 450px;">
            <div class="dialog-header-desktop">
                <h3 class="m-0 h5 fw-black">Tarih Aralığı Seçiniz</h3>
                <button class="dialog-close-btn" @onclick="ViewModel.CloseDateSelection">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>
            
            <div class="pa-6">
                <!-- Quick Buttons inside dialog -->
                <div class="d-flex gap-2 mb-4 justify-content-between">
                    <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Weekly" ? "active" : "")" style="flex: 1;" @onclick='() => ViewModel.SetDateFilter("Weekly")'>Haftalık</button>
                    <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Monthly" ? "active" : "")" style="flex: 1;" @onclick='() => ViewModel.SetDateFilter("Monthly")'>Aylık</button>
                    <button class="r-btn-period @(ViewModel.SelectedDateFilter == "Yearly" ? "active" : "")" style="flex: 1;" @onclick='() => ViewModel.SetDateFilter("Yearly")'>Yıllık</button>
                    <button class="r-btn-period @(ViewModel.SelectedDateFilter == "All" ? "active" : "")" style="flex: 1;" @onclick='() => ViewModel.SetDateFilter("All")'>Tümü</button>
                </div>

                <div class="mb-4">
                    <MudDatePicker @bind-Date="ViewModel.StartDate" Label="Başlangıç Tarihi" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" />
                </div>
                <div class="mb-4">
                    <MudDatePicker @bind-Date="ViewModel.EndDate" Label="Bitiş Tarihi" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" />
                </div>
            </div>
            
            <div class="pa-6 pt-0 d-flex justify-content-between">
                <button class="premium-button secondary" @onclick="ViewModel.CloseDateSelection">VAZGEÇ</button>
                <button class="premium-button primary" @onclick="ViewModel.SelectDateRangeAsync">RAPORU HAZIRLA</button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += (s, e) => {
             if (e.PropertyName == nameof(ViewModel.ErrorMessage) && !string.IsNullOrEmpty(ViewModel.ErrorMessage))
             {
                 Snackbar.Add(ViewModel.ErrorMessage, Severity.Error);
             }
             if (e.PropertyName == nameof(ViewModel.SuccessMessage) && !string.IsNullOrEmpty(ViewModel.SuccessMessage))
             {
                 Snackbar.Add(ViewModel.SuccessMessage, Severity.Success);
             }
             InvokeAsync(StateHasChanged);
        };
    }

    private string GetIcon(string? iconName) => iconName switch
    {
        "Apps" => Icons.Material.Filled.Apps,
        "DataTrending" => Icons.Material.Filled.TrendingUp,
        "Payment" => Icons.Material.Filled.Payment,
        "Money" => Icons.Material.Filled.AttachMoney,
        "MoneyHand" => Icons.Material.Filled.PriceCheck,
        "BuildingBank" => Icons.Material.Filled.AccountBalance,
        "People" => Icons.Material.Filled.People,
        "History" => Icons.Material.Filled.History,
        "Timer" => Icons.Material.Filled.Timer,
        "PersonOff" => Icons.Material.Filled.PersonOff,
        "Box" => Icons.Material.Filled.Inventory,
        "ArrowSwap" => Icons.Material.Filled.SwapVert,
        "Warning" => Icons.Material.Filled.Warning,
        "BoxDismiss" => Icons.Material.Filled.Inventory2,
        "ArrowTrendingLines" => Icons.Material.Filled.AutoGraph,
        "Receipt" => Icons.Material.Filled.Receipt,
        "Tag" => Icons.Material.Filled.LocalOffer,
        "PersonStar" => Icons.Material.Filled.StarRate,
        "Globe" => Icons.Material.Filled.Public,
        "Star" => Icons.Material.Filled.Grade,
        "DocumentData" => Icons.Material.Filled.Description,
        "Timeline" => Icons.Material.Filled.Timeline,
        "ReceiptMoney" => Icons.Material.Filled.RequestQuote,
        "Filter" => Icons.Material.Filled.FilterAlt,
        "ArrowRepeat" => Icons.Material.Filled.CompareArrows,
        "Alarm" => Icons.Material.Filled.Alarm,
        "Location" => Icons.Material.Filled.Place,
        "PersonDelete" => Icons.Material.Filled.PersonRemove,
        "ShowChart" => Icons.Material.Filled.ShowChart,
        "Heart" => Icons.Material.Filled.Favorite,
        "Map" => Icons.Material.Filled.Map,
        "Speedometer" => Icons.Material.Filled.Speed,
        "Target" => Icons.Material.Filled.TrackChanges,
        _ => Icons.Material.Filled.Description
    };
}

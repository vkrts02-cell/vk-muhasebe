    private void MoveItem(string id, int direction)
    {
        var index = _itemsOrder.IndexOf(id);
        if (index < 0) return;
        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= _itemsOrder.Count) return;
        _itemsOrder.RemoveAt(index);
        _itemsOrder.Insert(newIndex, id);
        StateHasChanged();
    }

    private string _draggingId = "";

    private void HandleDragStart(string id)
    {
        _draggingId = id;
    }

    private void HandleDrop(string targetId)
    {
        if (string.IsNullOrEmpty(_draggingId) || _draggingId == targetId) return;
        
        int oldIndex = _itemsOrder.IndexOf(_draggingId);
        int newIndex = _itemsOrder.IndexOf(targetId);
        
        if (oldIndex != -1 && newIndex != -1)
        {
            _itemsOrder.RemoveAt(oldIndex);
            _itemsOrder.Insert(newIndex, _draggingId);
            _draggingId = "";
            
            // Live Preview: Update LocalStorage and notify layout
            LocalStorage.SetItem("sb_items_order", _itemsOrder);
            UiService.NotifyBarSettingsChanged();
            
            StateHasChanged();
        }
    }


    protected override async Task OnInitializedAsync()
    {
        UiService.OnEscapePressed += HandleEscape;
        try
        {
            if (LocalStorage.ContainKey("firebase_url"))
                _firebaseUrl = LocalStorage.GetItem<string>("firebase_url") ?? "";

            if (LocalStorage.ContainKey("firebase_token"))
                _firebaseToken = LocalStorage.GetItem<string>("firebase_token") ?? "";

            if (LocalStorage.ContainKey("company_logo"))
                _companyLogo = LocalStorage.GetItem<string>("company_logo") ?? "";

            if (LocalStorage.ContainKey("auto_scale_enabled"))
                _isAutoScalingEnabled = LocalStorage.GetItem<bool>("auto_scale_enabled");

            if (LocalStorage.ContainKey("app_scale"))
            {
                var val = LocalStorage.GetItem<object>("app_scale");
                if (val != null && double.TryParse(val.ToString()?.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var s))
                {
                    _appScale = s;
                }
            }

            // Correctly derive current scale if it was auto-detected at startup
            if (_isAutoScalingEnabled)
            {
                await AutoDetectScaling();
            }
            else if (LocalStorage.ContainKey("app_scale"))
            {
                // Manual scale was already loaded above
                await SetScale(_appScale, false);
            }

            if (LocalStorage.ContainKey("app_theme"))
                _selectedTheme = LocalStorage.GetItem<string>("app_theme") ?? "standard";

            LoadBarSettings();

            await LoadUsers();
            await LoadAvailableYears();

            var profil = await DbService.GetFirmaProfiliAsync();
            if (profil != null && profil.StartingYear > 2000)
            {
                _startingYear = profil.StartingYear;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sayfa yÃƒÂ¼kleme hatasÃ„Â±: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAvailableYears()
    {
        try 
        {
            _availableYears = await FirebaseService.GetAvailableYearsAsync();
            if (_availableYears.Any())
            {
                if (_selectedYearToSwitch == 0) _selectedYearToSwitch = YearContext.CurrentYear;
                if (_transferFromYear == 0) _transferFromYear = YearContext.CurrentYear;
                if (_selectedYearToDelete == 0) _selectedYearToDelete = _availableYears.Last();
                
                // Ensure ToYear is logically set to something else than FromYear
                if (_transferToYear == YearContext.CurrentYear)
                    _transferToYear = _availableYears.Max() + 1;
            }
            StateHasChanged();
        }
        catch (Exception ex) 
        {
             Console.WriteLine("LoadYears Error: " + ex.Message);
        }
    }


    private async Task OnScaleChanged(ChangeEventArgs e)
    {
        string val = e.Value?.ToString() ?? "1";
        if (double.TryParse(val.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var scale))
        {
            await SetScale(scale);
        }
    }

    private async Task OnAutoScalingToggled(bool value)
    {
        _isAutoScalingEnabled = value;
        LocalStorage.SetItem("auto_scale_enabled", _isAutoScalingEnabled);
        
        if (_isAutoScalingEnabled)
        {
            await AutoDetectScaling();
        }
        else 
        {
            // Reset to 100% or keep current scale but stop auto-updates?
            // Usually, turning off auto means keeping the current but allowing manual.
            await SetScale(_appScale, false);
        }
    }

    private async Task SetScale(double scale, bool isManual = true)
    {
        if (isManual) _isAutoScalingEnabled = false;
        
        var resultStr = await JS.InvokeAsync<string>("applyAppScaling", scale, false);
        if (!string.IsNullOrEmpty(resultStr) && double.TryParse(resultStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var finalScale))
        {
            _appScale = finalScale;
        }

        LocalStorage.SetItem("app_scale", _appScale);
        LocalStorage.SetItem("auto_scale_enabled", _isAutoScalingEnabled);
        
        StateHasChanged();
    }

    private async Task AutoDetectScaling()
    {
        if (!_isAutoScalingEnabled) return;
        
        try
        {
            var resultStr = await JS.InvokeAsync<string>("applyAppScaling", 1.0, true);
            if (!string.IsNullOrEmpty(resultStr) && double.TryParse(resultStr.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var s))
            {
                _appScale = s;
                LocalStorage.SetItem("app_scale", _appScale);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }


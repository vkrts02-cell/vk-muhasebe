<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Shared.ViewModels;assembly=ErmayMuhasebe.Shared"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ErmayMuhasebe.Avalonia.Views.PortfoyListView"
             x:DataType="vm:PortfoyListViewModel">

  <Grid RowDefinitions="Auto, *" Margin="20">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,25">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
            <Border Background="{StaticResource FluidBlueGradient}" Width="48" Height="48" CornerRadius="12">
                <ic:SymbolIcon Symbol="People" Foreground="White" FontSize="24" HorizontalAlignment="Center"/> 
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Portföy Listesi" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Potansiyel müşterilerinizi takip edin ve carilere aktarın" FontSize="12" Foreground="#88FFFFFF"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
            <Button Command="{Binding DownloadCariListCommand}" Classes="SideButton Secondary" Width="160" Height="40">
                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Grid.Column="0" Symbol="ArrowDownload" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/> 
                    <TextBlock Grid.Column="1" Text="Carileri İndir" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button Command="{Binding DownloadExcelTemplateCommand}" Classes="SideButton Secondary" Width="160" Height="40">
                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Grid.Column="0" Symbol="ArrowDownload" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/> 
                    <TextBlock Grid.Column="1" Text="Şablon İndir" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button Command="{Binding UploadExcelCommand}" Classes="SideButton Info" Width="160" Height="40">
                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Grid.Column="0" Symbol="ArrowUpload" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/> 
                    <TextBlock Grid.Column="1" Text="Excel'den Yükle" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button Command="{Binding OpenAddPortfoyCommand}" Classes="SideButton Info" Width="160" Height="40" Background="#2ecc71">
                <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Grid.Column="0" Symbol="Add" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/> 
                    <TextBlock Grid.Column="1" Text="Yeni Kayıt" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10">
      <DataGrid ItemsSource="{Binding PortfoyListesi}" 
                SelectedItem="{Binding SelectedPortfoy}"
                AutoGenerateColumns="False" IsReadOnly="True"
                GridLinesVisibility="Horizontal" Background="Transparent"
                RowHeight="45">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Düzenle" Command="{Binding EditPortfoyCommand}" CommandParameter="{Binding SelectedPortfoy}">
              <MenuItem.Icon><ic:SymbolIcon Symbol="Edit"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Sil" Command="{Binding DeletePortfoyConfirmCommand}" CommandParameter="{Binding SelectedPortfoy}" Foreground="#FF416C">
              <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" Foreground="#FF416C"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Profilini Görüntüle" IsEnabled="False">
               <MenuItem.Icon><ic:SymbolIcon Symbol="Person"/></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Firma / Ünvan" Binding="{Binding FirmaIsmi}" Width="*"/>
          <DataGridTextColumn Header="Yetkili" Binding="{Binding YetkiliKisi}" Width="150"/>
          <DataGridTextColumn Header="GSM" Binding="{Binding GSM}" Width="150"/>
          <DataGridTextColumn Header="Şehir" Binding="{Binding Il}" Width="120"/>
          <DataGridTemplateColumn Header="İşlemler" Width="125">
              <DataTemplate>
                  <Button Command="{Binding $parent[UserControl].DataContext.TransferToCariCommand}" 
                          CommandParameter="{Binding}"
                          Classes="SideButton Info" Width="105" Height="28" Padding="6,0"
                          HorizontalAlignment="Center"
                          ToolTip.Tip="Cari Hesaplara Aktar">
                      <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <ic:SymbolIcon Grid.Column="0" Symbol="ArrowRight" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                          <TextBlock Grid.Column="1" Text="Cari'ye Aktar" FontSize="11" VerticalAlignment="Center"/>
                      </Grid>
                  </Button>
              </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- DELETE/ACTION CONFIRMATION OVERLAY -->
    <Grid Grid.RowSpan="2" Background="#E6000000" IsVisible="{Binding IsConfirmVisible}">
         <Border Background="#080A0C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 20 60 0 #CC000000" ClipToBounds="True">
             <Grid RowDefinitions="Auto, *">
                  <Border Grid.Row="0" Background="#26FF416C" Padding="20,12">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:SymbolIcon Symbol="Delete" Foreground="White" FontSize="20"/> 
                          <TextBlock Text="Onay Gerekiyor" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                      </StackPanel>
                  </Border>

                  <StackPanel Grid.Row="1" Margin="30" Spacing="25">
                      <ic:SymbolIcon Symbol="Warning" Foreground="#FF416C" FontSize="48" HorizontalAlignment="Center"/> 
                      <StackPanel Spacing="8">
                          <TextBlock Text="{Binding ConfirmTitle}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="18"/>
                          <TextBlock Text="{Binding ConfirmMessage}" Foreground="#BBB" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                      </StackPanel>
                      
                      <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                          <Button Grid.Column="0" Classes="SideButton Danger" Command="{Binding ConfirmYesCommand}" Margin="0,0,5,0" Height="45">
                              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                  <ic:SymbolIcon Symbol="Checkmark" FontSize="18" VerticalAlignment="Center"/> 
                                  <TextBlock Text="EVET, SİL" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                              </StackPanel>
                          </Button>
                          <Button Grid.Column="1" Classes="SideButton Secondary" Command="{Binding ConfirmNoCommand}" Margin="5,0,0,0" Height="45">
                               <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                  <ic:SymbolIcon Symbol="Dismiss" FontSize="18" VerticalAlignment="Center"/> 
                                  <TextBlock Text="VAZGEÇ" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                               </StackPanel>
                          </Button>
                      </Grid>
                  </StackPanel>
             </Grid>
         </Border>
    </Grid>

    <!-- Detailed Add Dialog (Non-Scrolling Optimized Redesign) -->
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsAddDialogVisible}" Background="#AA000000">
        <Border Background="#080A0C" 
                Width="1100" Height="730" 
                VerticalAlignment="Center" HorizontalAlignment="Center" 
                CornerRadius="16" Padding="0"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                BoxShadow="0 20 60 0 #EE000000">
            <DockPanel LastChildFill="True">
                <!-- Dialog Header -->
                <Border DockPanel.Dock="Top" Padding="25,15" Background="#24292e" CornerRadius="16,16,0,0" BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                             <Border Background="{DynamicResource FluidBlueGradient}" Width="38" Height="38" CornerRadius="8">
                                <ic:SymbolIcon Symbol="PersonAdd" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                             </Border>
                             <TextBlock Text="Yeni Portföy / Cari Kaydı" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseDialogsCommand}" 
                                Background="#15FFFFFF" BorderThickness="0" Width="44" Height="44" CornerRadius="22" Padding="0">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="24" Foreground="#88FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Dialog Footer -->
                <Border DockPanel.Dock="Bottom" Padding="25,12" Background="#24292e" CornerRadius="0,0,16,16" BorderBrush="#11FFFFFF" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" Command="{Binding CloseDialogsCommand}" Classes="SideButton Secondary" Width="130" Height="40">
                             <StackPanel Orientation="Horizontal" Spacing="10">
                                 <ic:SymbolIcon Symbol="ArrowLeft" FontSize="18"/>
                                 <TextBlock Text="VAZGEÇ" FontWeight="Bold" VerticalAlignment="Center"/>
                             </StackPanel>
                        </Button>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="25">
                             <StackPanel VerticalAlignment="Center" Spacing="0">
                                 <TextBlock Text="Açılış Bakiyesi" FontSize="10" Foreground="#88FFFFFF" HorizontalAlignment="Right"/>
                                 <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                     <TextBlock Text="{Binding NewPortfoy.AcilisBakiyesi, StringFormat='N2'}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                     <TextBlock Text="₺" VerticalAlignment="Center" FontWeight="Bold" Foreground="#88FFFFFF"/>
                                 </StackPanel>
                             </StackPanel>
                             
                             <Button Command="{Binding SavePortfoyCommand}" Classes="SideButton Success" Width="160" Height="42" Background="#2ecc71" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon Symbol="Save" FontSize="18" Foreground="White"/>
                                    <TextBlock Text="KAYDET" FontWeight="Black" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dialog Content -->
                <Grid ColumnDefinitions="400, 1, *" Margin="0">
                    <!-- Left: Basic Info -->
                    <Border Grid.Column="0" Padding="25" Background="#1c2128">
                        <StackPanel Spacing="15">
                            <Border Background="#1060A5FA" BorderBrush="#3060A5FA" BorderThickness="1" Padding="12,8" CornerRadius="8">
                                <TextBlock Text="TEMEL BİLGİLER" HorizontalAlignment="Center" FontWeight="Black" FontSize="12" Foreground="#60A5FA" LetterSpacing="1"/>
                            </Border>
                            
                            <Grid ColumnDefinitions="*, 15, *">
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Cari Tipi" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                    <ComboBox SelectedItem="{Binding NewPortfoy.CariTipi}" HorizontalAlignment="Stretch" Height="36" CornerRadius="6">
                                        <x:String>Müşteri</x:String>
                                        <x:String>Tedarikçi</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Yetkili Kişi" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF"/>
                                    <TextBox Text="{Binding NewPortfoy.YetkiliKisi}" Watermark="Ad Soyad" Height="36" CornerRadius="6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
    
                            <StackPanel Spacing="5">
                                <TextBlock Text="Hesap / Firma Adı" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                <TextBox Text="{Binding NewPortfoy.FirmaIsmi}" Watermark="Firma Ünvanı" AcceptsReturn="True" Height="70" TextWrapping="Wrap" CornerRadius="6" FontSize="13" Padding="8"/>
                            </StackPanel>
        
                            <Grid ColumnDefinitions="*, 15, *">
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Vade Günü" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF"/>
                                    <NumericUpDown Value="{Binding NewPortfoy.VadeGunu}" Height="36" ShowButtonSpinner="False" CornerRadius="6" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5">
                                    <TextBlock Text="Risk Limiti" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF"/>
                                    <NumericUpDown Value="{Binding NewPortfoy.RiskLimiti}" Height="36" ShowButtonSpinner="False" CornerRadius="6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
        
                            <StackPanel Spacing="5">
                                 <TextBlock Text="Cari Kart Açıklaması" FontSize="11" FontWeight="SemiBold" Foreground="#88FFFFFF"/>
                                 <TextBox Text="{Binding NewPortfoy.Aciklama}" Watermark="Genel notlar..." Height="200" AcceptsReturn="True" TextWrapping="Wrap" CornerRadius="6" FontSize="12" Padding="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="#22FFFFFF" Width="1"/>

                    <!-- Right Column: Tabs -->
                    <Border Grid.Column="2" Padding="25" Background="#161b22">
                        <TabControl Background="Transparent" Padding="0">
                            <!-- Tab 1: Contact -->
                            <TabItem Header="İletişim &amp; Adres">
                                <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="0,15,0,0">
                                    <Grid Grid.Row="0" ColumnDefinitions="*, 20, *" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Telefon" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.Telefon}" Watermark="Sabit Hat" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Cep Telefonu" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.GSM}" Watermark="Mobil Hat" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*, 20, *" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="E-Mail" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.Email}" Watermark="iletisim@firma.com" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Web Adresi" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.WebSitesi}" Watermark="www.firma.com" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="*, 20, *" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Vergi Dairesi" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.VergiDairesi}" Watermark="Daire Adı" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Vergi No / T.C." FontSize="10" Foreground="#60A5FA" FontWeight="Bold"/>
                                            <TextBox Text="{Binding NewPortfoy.VKN}" Watermark="VKN/TCKN" CornerRadius="6" Height="34" FontSize="12" BorderBrush="#3360A5FA"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="3" ColumnDefinitions="*, 15, *, 15, *" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Ülke" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.Ulke}" Watermark="Türkiye" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="İl" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.Il}" Watermark="Şehir" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Spacing="5">
                                            <TextBlock Text="İlçe" FontSize="10" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.Ilce}" Watermark="İlçe" CornerRadius="6" Height="34" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4" ColumnDefinitions="*, 20, *">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="Ana Adres" FontSize="11" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.Adres}" Watermark="Açık Adres" Height="150" AcceptsReturn="True" TextWrapping="Wrap" CornerRadius="8" Padding="10" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="Sevk Adresi" FontSize="11" Foreground="#88FFFFFF"/>
                                            <TextBox Text="{Binding NewPortfoy.SevkAdresi}" Watermark="Gönderim Adresi" Height="150" AcceptsReturn="True" TextWrapping="Wrap" CornerRadius="8" Padding="10" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Risk &amp; Limit">
                                <StackPanel Spacing="15" Margin="0,20,0,0">
                                    <Border Background="#1060A5FA" BorderBrush="#2060A5FA" BorderThickness="1" Padding="20" CornerRadius="12">
                                        <StackPanel Spacing="15">
                                            <TextBlock Text="FİNANSAL RİSK PARAMETRELERİ" Foreground="#60A5FA" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                            <CheckBox Content="Risk Takibi Yapılsın (Limiti Aşınca Uyar)" IsChecked="{Binding NewPortfoy.RiskTakibiYapilsin}" Foreground="White" FontSize="13"/>
                                            <CheckBox Content="Vadesi Geçmiş Borçlarda İşlem Engelle" IsChecked="{Binding NewPortfoy.VadeGecmisteEngelle}" Foreground="White" FontSize="13"/>
                                            <CheckBox Content="Fatura Keserken Risk Kontrolü Yap" IsChecked="{Binding NewPortfoy.FaturadaRiskKontrolu}" Foreground="White" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#10F87171" BorderBrush="#20F87171" BorderThickness="1" Padding="15" CornerRadius="10">
                                        <TextBlock Text="⚠️ Bu ayarlar cari hesaba aktarıldığında aktif olacaktır." FontSize="11" Foreground="#F87171" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ErmayMuhasebe.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ErmayMuhasebe.Avalonia.Views.MainWindow"
        Icon="avares://ErmayMuhasebe.Avalonia/Assets/avalonia-logo.ico"
        Title="VK Ön Muhasebe"
        Background="{DynamicResource BackgroundBrush}"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        MinWidth="960"
        MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
        <views:MainView />
</Window>

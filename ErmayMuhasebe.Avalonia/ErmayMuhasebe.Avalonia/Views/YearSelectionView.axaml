<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:conv="clr-namespace:ErmayMuhasebe.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ErmayMuhasebe.Avalonia.Views.YearSelectionView"
             x:DataType="vm:YearSelectionViewModel">

    <UserControl.Resources>
        <conv:ObjectIsNullConverter x:Key="ObjectIsNotNullConverter" Inverted="True" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.LinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LinkButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Styles>

    <!-- Whole screen background synced with application theme (#0A0A0A) -->
    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Width="400" Margin="24">
            
            <!-- Ana Seçim Kartı (Uygulama Tasarımı: PanelBrush #161616 & BorderColor) -->
            <Border Background="{DynamicResource PanelBrush}" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1.5" 
                    CornerRadius="22" 
                    Padding="32"
                    BoxShadow="0 25 60 0 #60000000">
                <StackPanel Spacing="22">
                    
                    <!-- Logo & Başlık Alanı -->
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Image Source="avares://ErmayMuhasebe.Avalonia/Assets/vk_logo.png"
                               Width="68" Height="68"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                        
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Çalışma Yılı Seçimi" 
                                       FontSize="22" 
                                       FontWeight="Black" 
                                       LetterSpacing="-0.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                            
                            <TextBlock Text="Lütfen çalışmak istediğiniz mali yılı seçiniz" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hata / Bilgi Mesajı -->
                    <Border Background="#1510B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="14,10"
                            IsVisible="{Binding FeedbackMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto, *">
                            <ic:SymbolIcon Symbol="Info" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" FontSize="12" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Yıllar Listesi (SurfaceBrush & BorderColor ile uygulama renk uyumu) -->
                    <Border Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="16" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource BorderColor}"
                            Padding="8"
                            IsVisible="{Binding !HasNoYears}">
                        <ListBox ItemsSource="{Binding Years}" 
                                 SelectedItem="{Binding SelectedYear}"
                                 Background="Transparent"
                                 MaxHeight="240">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <Border Padding="16,13" CornerRadius="12">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <ic:SymbolIcon Symbol="CalendarMonth" FontSize="20" Foreground="#60A5FA" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding, StringFormat='{}{0} Mali Yılı'}" 
                                                       FontSize="15" 
                                                       FontWeight="Bold"
                                                       Margin="14,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                            <ic:SymbolIcon Symbol="ChevronRight" FontSize="16" Opacity="0.5" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter Name="PART_ContentPresenter"
                                                              Background="{TemplateBinding Background}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}"
                                                              Padding="{TemplateBinding Padding}"
                                                              CornerRadius="12"/>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#0061FF"/>
                                    <Setter Property="TextBlock.Foreground" Value="White"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#15FFFFFF"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Border>

                    <!-- Yeni Yıl Ekleme (Sadece hiç yıl yoksa görünür) -->
                    <Border Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="16" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource BorderColor}"
                            Padding="24,20"
                            IsVisible="{Binding HasNoYears}">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="CalendarAdd" FontSize="36" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Mali Yıl Bulunamadı" 
                                           FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Başlamak için lütfen çalışmak istediğiniz mali yılı girip oluşturun." 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Yıl Giriş Kutusu ve Kompakt Buton -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,0"
                                        Height="40"
                                        Width="130"
                                        VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <ic:SymbolIcon Symbol="Calendar" FontSize="18" Foreground="#60A5FA" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding NewYearToCreateText, Mode=TwoWay}" 
                                                 FontSize="15" 
                                                 FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 Watermark="2026"
                                                 MaxLength="4"/>
                                    </Grid>
                                </Border>

                                <!-- Kompakt Oluştur Butonu -->
                                <Button Command="{Binding CreateNewYearCommand}" 
                                        Height="40"
                                        Width="120"
                                        MaxWidth="120"
                                        Padding="0"
                                        Background="{DynamicResource FluidBlueGradient}" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        CornerRadius="10" 
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="AddCircle" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Oluştur" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Butonlar -->
                    <StackPanel Spacing="12" IsVisible="{Binding !HasNoYears}">
                        <!-- Uygulamayı Başlat / Seçilen Yıla Geç -->
                        <Button Command="{Binding SelectYearCommand}" 
                                Height="48"
                                Background="{DynamicResource FluidBlueGradient}" 
                                Foreground="White" 
                                CornerRadius="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                IsEnabled="{Binding SelectedYear, Converter={StaticResource ObjectIsNotNullConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="ArrowRight" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Vazgeç / Ana Menüye Dön (Oturum Açılmışsa) -->
                        <Button Command="{Binding CancelCommand}" 
                                Classes="LinkButton"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                IsVisible="{Binding IsAlreadyAuthenticated}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowLeft" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Vazgeç / Ana Menüye Dön" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Farklı Kullanıcı ile Giriş Yap (Giriş Ekranından Gelindiyse) -->
                        <Button Command="{Binding SwitchUserCommand}" 
                                Classes="LinkButton"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                IsVisible="{Binding !IsAlreadyAuthenticated}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Person" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Farklı Kullanıcı ile Giriş Yap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>

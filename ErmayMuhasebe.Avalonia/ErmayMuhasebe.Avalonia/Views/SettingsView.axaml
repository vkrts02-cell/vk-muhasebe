<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:conv="using:ErmayMuhasebe.Avalonia.Converters"
             x:Class="ErmayMuhasebe.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <UserControl.Resources>
      <conv:SymbolIconConverter x:Key="SymbolIconConverter"/>
      <conv:ObjectIsNullConverter x:Key="ObjectIsNullConverter" Inverted="False"/>
      <conv:ObjectIsNullConverter x:Key="ObjectIsNotNullConverter" Inverted="True"/>
      <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
      <conv:BoolToDoubleConverter x:Key="BoolToDoubleConverter" TrueValue="1.0" FalseValue="0.4"/>
      <conv:BoolToBlueBrushConverter x:Key="BoolToBlueBrushConverter"/>
      <conv:BoolToRedGreenConverter x:Key="BoolToRedGreenConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, Auto, *" Margin="10,0,10,10" Background="{DynamicResource BackgroundBrush}">
        <!-- Header Section -->
        <Border Grid.Row="0" Margin="10,20,10,20">
            <Grid ColumnDefinitions="Auto, *">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="25">
                    <Button Command="{Binding GoBackCommand}" 
                            IsVisible="{Binding CurrentCategory, Converter={StaticResource ObjectIsNotNullConverter}}"
                            Classes="SideButton" Background="{DynamicResource SurfaceBrush}" BorderThickness="1.5"
                            Width="52" Height="52" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <ic:SymbolIcon Symbol="ArrowLeft" FontSize="24" Foreground="White" />
                    </Button>
                    
                    <Panel>
                        <!-- Main Icon -->
                        <Border Width="60" Height="60" CornerRadius="18" Background="rgba(96, 165, 250, 0.15)"
                                IsVisible="{Binding CurrentCategory, Converter={StaticResource ObjectIsNullConverter}}">
                            <ic:SymbolIcon Symbol="Settings" Foreground="#60A5FA" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                        </Border>
                        
                        <!-- Category Icon -->
                        <Border Width="60" Height="60" CornerRadius="18" Background="{Binding CurrentCategory.Color}" Opacity="0.15"
                                IsVisible="{Binding CurrentCategory, Converter={StaticResource ObjectIsNotNullConverter}}">
                            <ic:SymbolIcon Symbol="{Binding CurrentCategory.Icon, Converter={StaticResource SymbolIconConverter}}" 
                                           Foreground="{Binding CurrentCategory.Color}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                        </Border>
                    </Panel>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding CurrentCategory.Title, FallbackValue='Uygulama Ayarları'}" 
                                   FontSize="34" FontWeight="Black" Foreground="White" LetterSpacing="-0.8"/>
                        <TextBlock Text="{Binding CurrentCategory.Description, FallbackValue='Sistem yapılandırmasını ve kullanıcı tercihlerini buradan yönetebilirsiniz.'}" 
                                   FontSize="15" Foreground="#94a3b8" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Messages Row -->
        <StackPanel Grid.Row="1" Margin="20,0,20,15" Spacing="8">
             <Border Background="rgba(16, 185, 129, 0.15)" BorderBrush="#10b981" BorderThickness="1.5" CornerRadius="12" Padding="20,15"
                     IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Grid ColumnDefinitions="Auto, *">
                      <ic:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle" Foreground="#10b981" FontSize="22" Margin="0,0,15,0" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Text="{Binding SuccessMessage}" Foreground="#10b981" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
             </Border>
             <Border Background="rgba(239, 68, 68, 0.15)" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="12" Padding="20,15"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Grid ColumnDefinitions="Auto, *">
                      <ic:SymbolIcon Grid.Column="0" Symbol="ErrorCircle" Foreground="#ef4444" FontSize="22" Margin="0,0,15,0" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#ef4444" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
             </Border>
        </StackPanel>
        
        <!-- Main Content Area with Scroll Support -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10,0,10,20">
                <!-- 1. Categories Grid (Initial State) -->
                <Panel IsVisible="{Binding CurrentCategory, Converter={StaticResource ObjectIsNullConverter}}">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingCategory">
                                <Button Command="{Binding $parent[UserControl].DataContext.SelectCategoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="0" 
                                        Width="370" 
                                        Height="220" 
                                        Margin="0,0,10,10"
                                        Theme="{x:Null}">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <Panel>
                                                        <ContentPresenter Name="PART_ContentPresenter"
                                                                          Background="{TemplateBinding Background}"
                                                                          BorderBrush="{TemplateBinding BorderBrush}"
                                                                          BorderThickness="{TemplateBinding BorderThickness}"
                                                                          CornerRadius="{TemplateBinding CornerRadius}"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          Padding="{TemplateBinding Padding}"
                                                                          HorizontalContentAlignment="Stretch"
                                                                          VerticalContentAlignment="Stretch"/>
                                                    </Panel>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <Style Selector="Button:pointerover Border#CardBorder">
                                            <Setter Property="BorderBrush" Value="{Binding Color}"/>
                                            <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                        </Style>
                                    </Button.Styles>
                                    <Border Name="CardBorder" Margin="10" Background="{DynamicResource PanelBrush}" 
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" 
                                            CornerRadius="20" Padding="24">
                                        <Border.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!-- Top Icon and Badge -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                                                <Panel Grid.Column="0">
                                                    <Border Width="48" Height="48" CornerRadius="14" Background="{Binding Color}" Opacity="0.15"/>
                                                    <ic:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource SymbolIconConverter}}" 
                                                                   Foreground="{Binding Color}" FontSize="24" 
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                                                </Panel>
                                                
                                                <Border Grid.Column="1" IsVisible="{Binding IsImplemented}" 
                                                        Background="{DynamicResource FluidGreenGradient}" CornerRadius="8" Padding="6,2" 
                                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock Text="AKTİF" FontSize="10" FontWeight="Black" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- Main Content -->
                                            <StackPanel Grid.Row="1" Margin="0,15,0,0" Spacing="5">
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Footer Status -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{Binding Color}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Color}" Opacity="0.8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
    
                <!-- 2. Settings Detail Views -->
                <Panel IsVisible="{Binding CurrentCategory, Converter={StaticResource ObjectIsNotNullConverter}}">
                    <StackPanel Spacing="25" Margin="0,0,0,20">
                        
                        <!-- Section: System & Backup -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='system'}">
                            <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Info" FontSize="24" Foreground="#60a5fa"/> 
                                    <TextBlock Text="Sistem Bilgileri ve Veritabanı" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="180, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="15">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Program Sürümü" Foreground="#94a3b8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" FontWeight="Black" Foreground="#60a5fa" FontSize="18"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Veritabanı Yolu" Foreground="#94a3b8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath}" FontSize="12" TextWrapping="Wrap" Opacity="0.8" FontFamily="Netflix Sans, Inter, Roboto, Segoe UI"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Son Başarılı Yedek" Foreground="#94a3b8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastBackupDate}" FontWeight="Black" Foreground="#10b981" FontSize="18"/>
                                </Grid>
                                
                                <Separator Background="{DynamicResource BorderColor}" Margin="0,10"/>
    
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                                    <Button Grid.Column="0" Command="{Binding ChangeDatabasePathCommand}" 
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" 
                                            Height="54" CornerRadius="12"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Grid ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="FolderOpen" FontSize="20" Foreground="#60a5fa" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Veritabanı Yolunu Değiştir" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    
                                    <Button Grid.Column="1" Command="{Binding CreateBackupCommand}" IsEnabled="{Binding !IsBusy}"
                                            Classes="Success" BorderThickness="1.5"
                                            Height="54" CornerRadius="12"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Grid ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Save" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Hızlı Yedek Al" FontWeight="Black" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="2" Command="{Binding RestoreBackupCommand}" IsEnabled="{Binding !IsBusy}"
                                            Classes="Warning" BorderThickness="1.5"
                                            Height="54" CornerRadius="12"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <Grid ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="History" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Yedek Geri Yükle" FontWeight="Black" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                                    <StackPanel Grid.Column="0" Spacing="12">
                                        <TextBlock Text="Çevrimdışı Mod" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ToggleSwitch IsChecked="{Binding IsOfflineMode}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IsOfflineMode, Converter={StaticResource BoolToRedGreenConverter}}" VerticalAlignment="Center" FontSize="13" Opacity="0.8"/>
                                        </StackPanel>
                                        <TextBlock Text="İnternet bağlantısı olmadan yerel verilerle çalışma." FontSize="11" Opacity="0.5"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <TextBlock Text="Bakım Modu" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ToggleSwitch IsChecked="{Binding IsMaintenanceMode}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IsMaintenanceMode, Converter={StaticResource BoolToRedGreenConverter}}" VerticalAlignment="Center" FontSize="13" Opacity="0.8"/>
                                        </StackPanel>
                                        <TextBlock Text="Sadece yönetici girişi ve bakım işlemleri." FontSize="11" Opacity="0.5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding BackupStatus}" FontSize="13" Foreground="#9CA3AF" FontWeight="Medium"
                                           Margin="0,10,0,0"
                                           IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Mali Yıl ve Devir İşlemleri -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" 
                                IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='rollover'}">
                            <StackPanel Spacing="24" MaxWidth="1050" HorizontalAlignment="Left">
                                
                                <!-- Section Title -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="CalendarClock" FontSize="24" Foreground="#10B981"/> 
                                    <TextBlock Text="Mali Yıl ve Dönem İşlemleri" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>

                                <!-- KART 1: Çalışma Yılı Yönetimi & Bakiye Yansıtma -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="22">
                                    <StackPanel Spacing="18">
                                        <!-- Header & Active Year Badge -->
                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="Çalışma Yılı Yönetimi" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"/>
                                                <TextBlock Text="Sistemde aktif olarak çalıştığınız mali yılı görüntüleyin, yıllar arası geçiş yapın veya bakiyeleri senkronize edin." FontSize="12" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="1" Background="rgba(56, 189, 248, 0.12)" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="14,7" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="CalendarCheckmark" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Aktif Mali Yıl:" FontSize="13" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ActiveYear, StringFormat='{}{0}'}" FontWeight="Black" Foreground="#38BDF8" FontSize="15" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,2"/>

                                        <!-- Action Buttons Toolbar -->
                                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                            <!-- Sol Kısım: Yıl Değiştir ve Sil -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="Mali Yıl Seç:" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYearToSwitch}" Width="120" Height="36" VerticalAlignment="Center"/>
                                                
                                                <Button Command="{Binding SwitchYearCommand}" Classes="Primary" Height="36" Width="125" Padding="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ic:SymbolIcon Symbol="ArrowRight" FontSize="15" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bu Yıla Geç" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding DeleteYearCommand}" Classes="Danger" Height="36" Width="95" Padding="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        ToolTip.Tip="Seçili mali yılı sil (Aktif yıl silinemez)">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ic:SymbolIcon Symbol="Delete" FontSize="15" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Yılı Sil" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Sağ Kısım: Sonraki Yıla Bakiye Yansıt (Düzgün Hizalı, Asla Genişlemez) -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding ReflectBalancesForwardCommand}" Classes="Warning" Height="36" Width="210" Padding="0" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        ToolTip.Tip="Bu yılda yapılan cari, stok ve kasa düzeltmelerini sonraki yılın açılış bakiyelerine aktarır">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ic:SymbolIcon Symbol="ArrowSync" FontSize="15" Foreground="#FF8C00" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Sonraki Yıla Bakiye Yansıt" FontWeight="Bold" FontSize="13" Foreground="#FF8C00" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- KART 2: Yeni Yıla Devir İşlemi Sihirbazı -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="22">
                                    <StackPanel Spacing="18">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="Yeni Yıla Devir Sihirbazı" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                                                <TextBlock Text="Eski yılın kapanış bakiyelerini ve kart tanımlarını seçtiğiniz modüllerle yeni mali yıla aktarır." FontSize="12" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="1" Background="rgba(16, 185, 129, 0.12)" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="Sparkle" FontSize="14" Foreground="#10B981" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Yeni Mali Yıl Oluştur" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Kaynak ve Hedef Yıl Seçim Kutuları -->
                                        <Grid ColumnDefinitions="*, Auto, *" Margin="0,4,0,0" VerticalAlignment="Center">
                                            <!-- Kaynak Yıl -->
                                            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <ic:SymbolIcon Symbol="ArrowExit" FontSize="16" Foreground="#94A3B8"/>
                                                        <TextBlock Text="Kaynak (Eski) Mali Yıl" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding RolloverSourceYear}" HorizontalAlignment="Stretch" Height="38"/>
                                                    <TextBlock Text="Kapanış bakiyelerinin okunacağı kaynak yıl" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Merkez Geçiş Oku -->
                                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#1E293B" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="16,0" VerticalAlignment="Center">
                                                <ic:SymbolIcon Symbol="ArrowRight" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Hedef Yıl -->
                                            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <ic:SymbolIcon Symbol="AddCircle" FontSize="16" Foreground="#10B981"/>
                                                        <TextBlock Text="Hedef (Yeni) Mali Yıl" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                    <NumericUpDown Value="{Binding RolloverTargetYear}" Minimum="2020" Maximum="2040" FormatString="0000" HorizontalAlignment="Stretch" Height="38"/>
                                                    <TextBlock Text="Açılış bakiyelerinin aktarılacağı yeni çalışma yılı" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Devredilecek Modüller -->
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="18">
                                            <StackPanel Spacing="14">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="CheckmarkStarburst" FontSize="18" Foreground="#38BDF8"/>
                                                    <TextBlock Text="Devredilecek Modüller ve Bakiyeler" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="14" ColumnSpacing="24">
                                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding RolloverCariler}">
                                                        <TextBlock Text="Cari Kartlar ve Kapanış Bakiyeleri (Devir Borç/Alacak)" FontSize="13" VerticalAlignment="Center"/>
                                                    </CheckBox>
                                                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding RolloverStoklar}">
                                                        <TextBlock Text="Stok Kartları ve Kalan Envanter Miktarları" FontSize="13" VerticalAlignment="Center"/>
                                                    </CheckBox>
                                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding RolloverKasaBanka}">
                                                        <TextBlock Text="Kasa ve Banka Açılış Bakiyeleri" FontSize="13" VerticalAlignment="Center"/>
                                                    </CheckBox>
                                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding RolloverCekSenet}">
                                                        <TextBlock Text="Açık ve Portföydeki Çek / Senetler" FontSize="13" VerticalAlignment="Center"/>
                                                    </CheckBox>
                                                    <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding RolloverTanimlar}">
                                                        <TextBlock Text="Firma Profili, Personeller ve Sabit Tanımlar" FontSize="13" VerticalAlignment="Center"/>
                                                    </CheckBox>
                                                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding RolloverAutoBackup}">
                                                        <TextBlock Text="Devir Öncesi Kaynak Yılı Otomatik Yedekle (.bak)" FontSize="13" VerticalAlignment="Center"/>
                                                    </CheckBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Devir İlerleme Çubuğu ve Buton -->
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6" Margin="0,0,24,0">
                                                <TextBlock Text="{Binding RolloverProgressMessage}" FontSize="13" Foreground="#38BDF8" FontWeight="SemiBold"
                                                           IsVisible="{Binding RolloverProgressMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" IsVisible="{Binding IsRolloverExecuting}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Command="{Binding ExecuteYearRolloverCommand}" 
                                                    Classes="Success" Height="40" Width="210" Padding="0" CornerRadius="9"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    IsEnabled="{Binding !IsRolloverExecuting}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="Play" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Yeni Yıla Devri Başlat" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- KART 3: Yıl Devir Ayarları & Senkronizasyon Kuralları -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="22">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Devir ve Senkronizasyon Tercihleri" FontSize="15" FontWeight="Bold" Foreground="#F59E0B"/>
                                        
                                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="16" ColumnSpacing="20">
                                            <!-- Otomatik Bakiye Yansıtma -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Eski Yılda Düzenlemede Otomatik Yansıt" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <ToggleSwitch IsChecked="{Binding AutoReflectBalancesOnChange}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding AutoReflectBalancesOnChange, Converter={StaticResource BoolToRedGreenConverter}}" VerticalAlignment="Center" FontSize="13" Opacity="0.8"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Geçmiş yılda fatura veya tahsilat düzenlendiğinde devir bakiyelerini sonraki yıla otomatik aktarır." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bakiyesiz Cariler -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Bakiyesiz Carileri Devretme" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <ToggleSwitch IsChecked="{Binding RolloverExcludeZeroBalances}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RolloverExcludeZeroBalances, Converter={StaticResource BoolToRedGreenConverter}}" VerticalAlignment="Center" FontSize="13" Opacity="0.8"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Kapanış bakiyesi 0 TL olan cari hesap kartlarını yeni yıla devretmez." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Sıfır Stoklu Ürünler -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Tükenen (0 Adet) Stok Kartları" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <ToggleSwitch IsChecked="{Binding RolloverTransferZeroStock}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RolloverTransferZeroStock, Converter={StaticResource BoolToRedGreenConverter}}" VerticalAlignment="Center" FontSize="13" Opacity="0.8"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Envanter miktarı sıfır olan ürünleri de yeni yıl stok listesine aktarır." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Devir Fişi Şablonu -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Devir Fişi Açıklama Şablonu" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    <TextBox Text="{Binding RolloverDevirFisiTemplate}" Height="36" VerticalContentAlignment="Center"/>
                                                    <TextBlock Text="Yeni yılda oluşturulacak açılış fişlerinin standart açıklaması." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- KART 4: Başlangıç Yılı ve Yıl Silme -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="22">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Başlangıç Yılı ve Yıl Yönetimi" FontSize="15" FontWeight="Bold" Foreground="#EF4444"/>
                                        
                                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" RowSpacing="16" ColumnSpacing="20">
                                            <!-- Başlangıç Yılı -->
                                            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Başlangıç Yılı" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <NumericUpDown Minimum="2000" Maximum="2100" Value="{Binding StartingYear}" Height="36" Width="120"/>
                                                        <Button Content="Kaydet" Command="{Binding SaveStartingYearCommand}" Classes="Success" Height="36" CornerRadius="6"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Programın dropdown listesindeki ilk yıl. (Örn: 2028)" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Yıl Silme -->
                                            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Yıl Sil (Tehlikeli İşlem!)" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ComboBox ItemsSource="{Binding AvailableYearsForDeletion}" SelectedItem="{Binding SelectedYearToDelete}" Height="36" Width="120" PlaceholderText="Yıl Seçin"/>
                                                        <Button Content="Seçili Yılı Sil" Command="{Binding DeleteYearCommand}" Classes="Danger" Height="36" CornerRadius="6" Background="#EF4444" Foreground="White"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Seçilen yılı hem bilgisayardan hem de buluttan tamamen siler!" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Foreground="#EF4444"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
    

    
                        <!-- Section: Appearance & Logo -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='appearance'}">
                            <StackPanel Spacing="25" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Image" FontSize="24" Foreground="#EC4899"/> 
                                    <TextBlock Text="Görünüm ve Logo Ayarları" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="240" Height="120" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="16">
                                       <Panel>
                                            <Image Source="{Binding LogoBytes, Converter={StaticResource BitmapAssetValueConverter}}" IsVisible="{Binding LogoBytes, Converter={x:Static ObjectConverters.IsNotNull}}" Stretch="Uniform" Margin="15"/>
                                            <ic:SymbolIcon Symbol="Image" FontSize="32" Opacity="0.4" IsVisible="{Binding LogoBytes, Converter={x:Static ObjectConverters.IsNull}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="15" Margin="30,0,0,0" VerticalAlignment="Center">
                                        <Button Command="{Binding SelectLogoCommand}" Classes="Info" Width="240" Height="52" CornerRadius="12" Content="Logo Yükle"/>
                                        <Button Command="{Binding DeleteLogoCommand}" Classes="Danger" Width="240" Height="52" CornerRadius="12" Content="Logoyu Kaldır" IsVisible="{Binding LogoBytes, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Separator Background="{DynamicResource BorderColor}" />
                                
                                <StackPanel Spacing="15">
                                    <TextBlock Text="Belgelerde Logo Gösterimi" FontSize="18" FontWeight="SemiBold" Foreground="#EC4899"/>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoFatura}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Faturalarda Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoSiparis}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Siparişlerde Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoTeklif}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Tekliflerde Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoEkstre}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Ekstrelerde Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoTahsilat}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Tahsilatlarda Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoOdeme}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Ödemelerde Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoAcilisBakiye}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Açılış Bakiyesinde Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,25,12" Spacing="10" Width="220">
                                            <ToggleSwitch IsChecked="{Binding LogoRaporlar}" OnContent="" OffContent="" VerticalAlignment="Center" CornerRadius="6"/>
                                            <TextBlock Text="Raporlarda Göster" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                                
                                <Separator Background="{DynamicResource BorderColor}" />
                                
                                <StackPanel Spacing="15">
                                    <TextBlock Text="Yazdırma Ayarları" FontSize="18" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding PrinterList}" SelectedItem="{Binding SelectedPrinter}" HorizontalAlignment="Stretch" Height="45"/>
                                    <Button Command="{Binding SaveAppearanceSettingsCommand}" Content="Tüm Ayarları Kaydet" Classes="Primary" Height="54" Padding="30,0" CornerRadius="12" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Security -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='security'}">
                            <StackPanel Spacing="25" MaxWidth="1000" HorizontalAlignment="Left">
                                
                                <!-- KART 1: Kişisel Bilgiler & Güvenlik Özeti -->
                                <Border Background="rgba(255, 255, 255, 0.02)" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="16" Padding="20" Width="800" HorizontalAlignment="Left">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="Hesap ve Güvenlik Yönetimi" FontSize="18" FontWeight="Black" Foreground="White"/>
                                            <TextBlock Text="Hesabınızın kullanıcı adı ve şifre durumunu güvenlik onay şifrenizle yönetin." FontSize="12" Foreground="#94a3b8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="rgba(74, 222, 128, 0.12)" CornerRadius="6" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:SymbolIcon Symbol="ShieldCheckmark" FontSize="12" Foreground="#4ADE80"/>
                                                    <TextBlock Text="Güvenlik Korumalı" Foreground="#4ADE80" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="rgba(244, 63, 94, 0.12)" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="{Binding ActiveUsername, StringFormat='Hesap: {0}'}" Foreground="#F43F5E" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Kullanıcı Seçimi Paneli -->
                                <Border Background="rgba(255, 255, 255, 0.01)" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="16" Padding="20" Width="800" HorizontalAlignment="Left">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="İşlem Yapılacak Kullanıcı Hesabı" FontSize="13" FontWeight="Bold" Opacity="0.8"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding UsersList}" SelectedItem="{Binding SelectedSecurityUser}" HorizontalAlignment="Stretch" Height="45" CornerRadius="10" IsEnabled="{Binding IsAdmin}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding Username}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Role, StringFormat='({0})'}" Opacity="0.5" FontSize="11"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- Seçili kullanıcının Telegram durumu -->
                                            <Border Grid.Column="1" Margin="15,0,0,0" CornerRadius="8" Background="rgba(59, 130, 246, 0.12)" IsVisible="{Binding SelectedSecurityUser.TelegramChatId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" Padding="8,4">
                                                <TextBlock Text="2FA Aktif" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- KART 2: Kullanıcı Adı ve Şifre Değiştirme Formları (Yan Yana) -->
                                <Grid ColumnDefinitions="*, 20, *" Width="800" HorizontalAlignment="Left">
                                    
                                    <!-- Sol Sütun: Kullanıcı Adı Değiştirme -->
                                    <Border Grid.Column="0" Background="rgba(255, 255, 255, 0.01)" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="16" Padding="20">
                                        <StackPanel Spacing="15">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="30" Height="30" CornerRadius="8" Background="rgba(59, 130, 246, 0.15)">
                                                    <ic:SymbolIcon Symbol="Person" FontSize="15" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Kullanıcı Adını Değiştir" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Separator Background="{DynamicResource BorderColor}" Margin="0,2"/>
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="Güvenlik Onay Şifresi" FontSize="11" Opacity="0.7"/>
                                                <TextBox PasswordChar="*" Text="{Binding AuthFactoryResetPasswordForUsername}" Watermark="Kurulum onay şifresi" Height="40" CornerRadius="8"/>
                                            </StackPanel>
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="Yeni Kullanıcı Adı" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding NewUsername}" Watermark="Yeni kullanıcı adı girin" Height="40" CornerRadius="8"/>
                                            </StackPanel>
                                            <Button Command="{Binding ChangeUsernameCommand}" Content="Kullanıcı Adını Güncelle" Classes="Primary" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sağ Sütun: Şifre Değiştirme -->
                                    <Border Grid.Column="2" Background="rgba(255, 255, 255, 0.01)" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="16" Padding="20">
                                        <Panel>
                                            <!-- Şifre Giriş Formu -->
                                            <StackPanel Spacing="15" IsVisible="{Binding !IsWaitingForTelegramApproval}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="30" Height="30" CornerRadius="8" Background="rgba(244, 63, 94, 0.15)">
                                                        <ic:SymbolIcon Symbol="ShieldLock" FontSize="15" Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Şifreyi Güncelle" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Separator Background="{DynamicResource BorderColor}" Margin="0,2"/>
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="Güvenlik Onay Şifresi" FontSize="11" Opacity="0.7"/>
                                                    <TextBox PasswordChar="*" Text="{Binding AuthFactoryResetPasswordForPassword}" Watermark="Kurulum onay şifresi" Height="40" CornerRadius="8"/>
                                                </StackPanel>
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="Yeni Şifre" FontSize="11" Opacity="0.7"/>
                                                    <TextBox PasswordChar="*" Text="{Binding NewPassword}" Watermark="Yeni şifrenizi girin" Height="40" CornerRadius="8"/>
                                                </StackPanel>
                                                <Button Command="{Binding ChangePasswordCommand}" Content="Şifreyi Güncelle" Classes="Danger" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Telegram Onay Bekleme Ekranı -->
                                            <StackPanel Spacing="15" IsVisible="{Binding IsWaitingForTelegramApproval}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="46" Height="46" CornerRadius="23" Background="rgba(59, 130, 246, 0.12)" HorizontalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="Send" FontSize="20" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <TextBlock Text="Telegram Onayı Bekleniyor" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TelegramApprovalStatusText}" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </StackPanel>
                                                <ProgressBar IsIndeterminate="True" Height="2" Foreground="#3B82F6" Width="120" HorizontalAlignment="Center" CornerRadius="1"/>
                                                <Button Command="{Binding StopTelegramApprovalCommand}" Content="İptal Et" Classes="Warning" Height="30" CornerRadius="6" HorizontalAlignment="Center" Padding="12,0"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                </Grid>

                                <!-- KART 3: Şifre Kurtarma Paneli (Expander İçinde) -->
                                <Expander Header="Şifremi Unuttum / Kurtarma Seçenekleri" Width="800" HorizontalAlignment="Left" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" Background="rgba(255, 255, 255, 0.01)" Padding="15">
                                    <StackPanel Spacing="15">
                                        <TextBlock Text="Kullanıcı adınızı veya kayıtlı e-posta adresinizi girip E-posta veya Telegram ile 6 haneli doğrulama kodu talep edebilirsiniz." FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding ResetUsername}" Watermark="Kullanıcı Adı veya E-posta" Height="45" CornerRadius="10"/>
                                        
                                        <Grid ColumnDefinitions="*, 15, *">
                                            <Button Grid.Column="0" Command="{Binding SendResetCodeCommand}" Content="E-posta ile Gönder" Classes="Primary" Height="42" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}"/>
                                            <Button Grid.Column="2" Command="{Binding SendResetCodeViaTelegramCommand}" Content="Telegram ile Gönder" Classes="Primary" Height="42" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}"/>
                                        </Grid>

                                        <!-- Doğrulama Kodu Girişi -->
                                        <StackPanel Spacing="12" IsVisible="{Binding ShowVerifyResetCodePanel}">
                                            <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                            <TextBox Text="{Binding ResetVerificationCode}" Watermark="6 Haneli Doğrulama Kodu" Height="45" CornerRadius="10"/>
                                            <Button Command="{Binding VerifyResetCodeCommand}" Content="Kodu Doğrula" Classes="Warning" Height="42" CornerRadius="10" HorizontalAlignment="Right" IsEnabled="{Binding !IsBusy}" Padding="25,0"/>
                                        </StackPanel>

                                        <!-- Yeni Şifre Girişi -->
                                        <StackPanel Spacing="12" IsVisible="{Binding IsResetCodeVerified}">
                                            <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                            <TextBox Text="{Binding ResetOneTimePassword}" Watermark="Telegram/E-postadan gelen tek kullanımlık şifre" Height="45" CornerRadius="10"/>
                                            <TextBox PasswordChar="*" Text="{Binding ResetNewPassword}" Watermark="Yeni Şifre Belirleyin" Height="45" CornerRadius="10"/>
                                            <Button Command="{Binding ConfirmResetPasswordCommand}" Content="Şifreyi Güncelle ve Bitir" Classes="Danger" Height="42" CornerRadius="10" HorizontalAlignment="Right" IsEnabled="{Binding !IsBusy}" Padding="20,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- KART 4: Sistem Kullanıcıları ve Yetkilendirme (Yalnızca Admin) -->
                                <Expander Header="Yönetici Paneli: Sistem Kullanıcıları ve Personel Yetkilendirme" IsVisible="{Binding IsAdmin}" Width="800" HorizontalAlignment="Left" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" Background="rgba(255, 255, 255, 0.01)" Padding="15">
                                    <StackPanel Spacing="20">
                                        <!-- Yeni Kullanıcı Tanımlama Formu -->
                                        <TextBlock Text="Yeni Kullanıcı Tanımla" FontSize="13" FontWeight="Bold" Opacity="0.8"/>
                                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *, *" RowSpacing="15" ColumnSpacing="15">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                                <TextBlock Text="Kullanıcı Adı" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBox Text="{Binding NewUsername}" Watermark="Örn: muhasebe1" Height="45" CornerRadius="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                                <TextBlock Text="Şifre" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBox PasswordChar="*" Text="{Binding NewUserPassword}" Watermark="Şifre belirleyin" Height="45" CornerRadius="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                                <TextBlock Text="Yetki Rolü" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <ComboBox SelectedItem="{Binding NewUserRole}" Height="45" CornerRadius="10" HorizontalAlignment="Stretch">
                                                    <ComboBox.Items>
                                                        <x:String>Yönetici</x:String>
                                                        <x:String>Operatör</x:String>
                                                    </ComboBox.Items>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                                <TextBlock Text="E-posta" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBox Text="{Binding NewUserEmail}" Watermark="kullanici@eposta.com" Height="45" CornerRadius="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                                <TextBlock Text="Telegram Chat ID" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBox Text="{Binding NewUserTelegramChatId}" Watermark="Telegram Chat ID" Height="45" CornerRadius="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                                <TextBlock Text="Firebase Auth UID" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBox Text="{Binding NewUserFirebaseAuthUid}" Watermark="Firebase UID" Height="45" CornerRadius="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6" IsVisible="{Binding IsManagerSelectionVisible}">
                                                <TextBlock Text="Bağlı Olacağı Yönetici" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <ComboBox ItemsSource="{Binding ManagersList}" SelectedItem="{Binding SelectedManagerForOperator}" Height="45" CornerRadius="10" HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Username}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <Button Grid.Row="2" Grid.Column="2" Command="{Binding AddUserCommand}" Content="Yeni Kullanıcı Ekle" Classes="Primary" Height="45" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>

                                        <!-- Sistemdeki Kullanıcılar Listesi -->
                                        <TextBlock Text="Kayıtlı Kullanıcılar" FontSize="13" FontWeight="Bold" Opacity="0.8"/>
                                        <ListBox ItemsSource="{Binding UsersList}" Background="Transparent" BorderThickness="0" MaxHeight="350">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="rgba(255, 255, 255, 0.01)" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*, Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                                                    <Border Background="rgba(244, 63, 94, 0.1)" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Role}" Foreground="#F43F5E" FontWeight="Bold" FontSize="9"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.DeleteUserCommand}" CommandParameter="{Binding}" Classes="Danger" Width="30" Height="30" CornerRadius="6" Padding="0">
                                                                    <ic:SymbolIcon Symbol="Delete" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*, 15, *">
                                                                <StackPanel Grid.Column="0" Spacing="8">
                                                                    <TextBox Text="{Binding Email, Mode=TwoWay}" Watermark="E-posta" Height="35" CornerRadius="6" FontSize="12"/>
                                                                    <TextBox Text="{Binding TelegramChatId, Mode=TwoWay}" Watermark="Telegram Chat ID" Height="35" CornerRadius="6" FontSize="12"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Spacing="8">
                                                                    <TextBox Text="{Binding FirebaseAuthUid, Mode=TwoWay}" Watermark="Firebase UID" Height="35" CornerRadius="6" FontSize="12"/>
                                                                    <TextBox PasswordChar="*" Text="{Binding TempPassword, Mode=TwoWay}" Watermark="Yeni Şifre" Height="35" CornerRadius="6" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*, 15, *">
                                                                <Button Grid.Column="0" Command="{Binding $parent[UserControl].DataContext.UpdateUserInfoCommand}" CommandParameter="{Binding}" Content="Bilgileri Kaydet" Classes="Primary" Height="35" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11"/>
                                                                <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.UpdateUserPasswordCommand}" CommandParameter="{Binding}" Content="Şifreyi Güncelle" Classes="Warning" Height="35" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>

                                <!-- KART 5: Fabrika Ayarları Sıfırlama (Yalnızca Admin) -->
                                <Expander Header="Yönetici Paneli: Fabrika Ayarları ve Sıfırlama Yetkisi" IsVisible="{Binding IsAdmin}" Width="800" HorizontalAlignment="Left" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}" Background="rgba(255, 255, 255, 0.01)" Padding="15">
                                    <StackPanel Spacing="15">
                                        <TextBlock Text="Sistemi tamamen sıfırlamak için onay şifresini girin:" FontSize="12" Foreground="#94a3b8"/>
                                        <TextBox PasswordChar="*" Text="{Binding AdminFactoryResetPassword}" Watermark="Onay Şifresi" Height="45" CornerRadius="10"/>
                                        
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                                            <Button Grid.Column="0" Command="{Binding ToggleFactoryResetVerificationPanelCommand}" Content="Kurtarma Şifresi Gönder" Classes="Warning" Height="42" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            <Button Grid.Column="1" Command="{Binding SaveAdminFactoryResetPasswordCommand}" Content="Onay Şifresini Kaydet" Classes="Primary" Height="42" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        </Grid>

                                        <!-- Kurtarma Doğrulama -->
                                        <StackPanel Spacing="12" IsVisible="{Binding ShowFactoryResetVerificationPanel}">
                                            <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                            <Button Command="{Binding SendFactoryResetCodeViaEmailCommand}" Content="E-posta ile Kurtarma Kodu Gönder" Classes="Info" Height="42" CornerRadius="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            
                                            <StackPanel Spacing="12" IsVisible="{Binding IsFactoryResetCodeSent}">
                                                <TextBox Text="{Binding FactoryResetVerificationCode}" Watermark="Doğrulama Kodu" Height="45" CornerRadius="10"/>
                                                <Button Command="{Binding ConfirmFactoryResetPasswordResetCommand}" Content="Doğrula ve Şifreyi Sıfırla" Classes="Danger" Height="42" CornerRadius="10" HorizontalAlignment="Right" Padding="20,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </Border>

                        <!-- Section: Cloud & API -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='cloud'}">
                            <StackPanel Spacing="25" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Cloud" FontSize="24" Foreground="#F59E0B"/> 
                                    <TextBlock Text="Bulut Senkronizasyon ve API Ayarları" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- 1. SUPABASE BULUT VERİTABANI -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="20">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ic:SymbolIcon Symbol="Database" FontSize="18" Foreground="#60A5FA"/>
                                            <TextBlock Text="Supabase Bulut Veritabanı (PostgreSQL)" FontSize="15" FontWeight="Bold" Foreground="#60A5FA"/>
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Bulut Veritabanı URL" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                            <TextBox Text="{Binding CloudUrl}" Watermark="https://your-project.supabase.co" Height="46" CornerRadius="10"/>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Supabase Anon / API Anahtarı (Anon / Service Role Key)" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                            <TextBox Text="{Binding CloudSecret}" PasswordChar="*" Watermark="Supabase API Key" Height="46" CornerRadius="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. GOOGLE CLOUD & QUESTPDF API -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="20">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ic:SymbolIcon Symbol="DocumentPdf" FontSize="18" Foreground="#10B981"/>
                                            <TextBlock Text="Bulut PDF Motoru (QuestPDF API)" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                        <TextBlock Text="Mobil ve harici servisler için çalışan QuestPDF sunucusunun bağlantı ve API anahtarı ayarları." FontSize="12" Foreground="#94a3b8"/>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="QuestPDF Bulut Servis URL'si" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                            <TextBox Text="{Binding CloudPdfApiUrl}" Watermark="https://ermay-pdf-api-390930978984.europe-west1.run.app" Height="46" CornerRadius="10"/>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Bulut Web API Anahtarı (API Key)" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                            <TextBox Text="{Binding CloudPdfApiKey}" Watermark="Web API Key" Height="46" CornerRadius="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="20" Margin="0,5,0,0">
                                    <Button Grid.Column="0" Command="{Binding SyncCloudCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="rgba(245, 158, 11, 0.15)" BorderBrush="#F59E0B" BorderThickness="1"
                                            Height="52" CornerRadius="12"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ic:SymbolIcon Symbol="ArrowSync" FontSize="20" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            <TextBlock Text="Verileri Bulut ile Eşitle" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding SaveCloudAndApiSettingsCommand}" IsEnabled="{Binding !IsBusy}"
                                            Background="rgba(16, 185, 129, 0.2)" BorderBrush="#10B981" BorderThickness="1.5"
                                            Height="52" CornerRadius="12"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ic:SymbolIcon Symbol="Save" FontSize="20" Foreground="#10B981" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bulut ve API Ayarlarını Kaydet" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                
                                <TextBlock Text="{Binding CloudStatus}" FontSize="13" Foreground="#94a3b8" IsVisible="{Binding CloudStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>
 
                        <!-- Section: Theme Selection -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='theme'}">
                            <StackPanel Spacing="25" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Color" FontSize="24" Foreground="#3b82f6"/> 
                                    <TextBlock Text="Arayüz Tasarımı ve Temalar" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="Uygulama Görünümü Seçin" FontSize="16" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,10,0,0"/>
                                
                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" ColumnSpacing="20">
                                    <!-- Modern SaaS Theme -->
                                    <Button Grid.Row="0" Grid.Column="0" Command="{Binding SetThemeCommand}" CommandParameter="ModernSaaS"
                                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch">
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter='ModernSaaS', Converter={StaticResource BoolToBlueBrushConverter}}" BorderThickness="2" CornerRadius="16" Padding="20">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <Border Width="160" Height="80" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="30, *">
                                                        <Border Grid.Column="0" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"/>
                                                        <StackPanel Grid.Column="1" Margin="10" Spacing="5">
                                                            <Border Width="30" Height="5" Background="#0061FF" CornerRadius="2" HorizontalAlignment="Left"/>
                                                            <Border Height="30" Background="rgba(255,255,255,0.05)" CornerRadius="4"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="Ermay Premium" FontWeight="Black" FontSize="16" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Modern ve akıcı cam tasarımı." FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
 
                                    <!-- IDE Professional Theme -->
                                    <Button Grid.Row="0" Grid.Column="1" Command="{Binding SetThemeCommand}" CommandParameter="IDEProfessional"
                                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch">
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding SelectedTheme, Converter={StaticResource StringEqualsConverter}, ConverterParameter='IDEProfessional', Converter={StaticResource BoolToBlueBrushConverter}}" BorderThickness="2" CornerRadius="16" Padding="20">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <Border Width="160" Height="80" Background="{DynamicResource BackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="30, *">
                                                        <Border Grid.Column="0" Background="rgba(255,255,255,0.05)" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"/>
                                                        <StackPanel Grid.Column="1" Margin="10" Spacing="5">
                                                            <Border Width="20" Height="5" Background="#007acc" CornerRadius="1" HorizontalAlignment="Left"/>
                                                            <Border Height="30" Background="rgba(255,255,255,0.02)" CornerRadius="0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="IDE Profesyonel" FontWeight="Black" FontSize="16" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Teknik ve odaklanmış yapı." FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                                
                                <Border Background="rgba(59, 130, 246, 0.15)" BorderBrush="#3b82f6" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ic:SymbolIcon Symbol="Info" Foreground="#3b82f6" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tema değişikliği tüm pencerelerde anında uygulanır." Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
 
                        <!-- Section: Display Scaling -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='display'}">
                            <StackPanel Spacing="25" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Desktop" FontSize="24" Foreground="#10b981"/> 
                                    <TextBlock Text="Ekran Ölçeklendirme" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Otomatik Ölçeklendirme" FontSize="16" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoScalingEnabled}" OnContent="" OffContent=""/>
                                </Grid>
     
                                <StackPanel Spacing="15" IsEnabled="{Binding !IsAutoScalingEnabled}" Opacity="{Binding !IsAutoScalingEnabled, Converter={StaticResource BoolToDoubleConverter}}">
                                    <Slider Value="{Binding CurrentScaling}" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Command="{Binding ChangeScalingCommand}" CommandParameter="0.75" Content="75%" Margin="0,0,10,10" Width="90" Height="50" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"/>
                                        <Button Command="{Binding ChangeScalingCommand}" CommandParameter="1.0" Content="100%" Margin="0,0,10,10" Width="90" Height="50" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"/>
                                        <Button Command="{Binding ChangeScalingCommand}" CommandParameter="1.25" Content="125%" Margin="0,0,10,10" Width="90" Height="50" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"/>
                                        <Button Command="{Binding ChangeScalingCommand}" CommandParameter="1.5" Content="150%" Margin="0,0,10,10" Width="90" Height="50" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"/>
                                        <Button Command="{Binding ChangeScalingCommand}" CommandParameter="2.0" Content="200%" Margin="0,0,10,10" Width="90" Height="50" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentScaling, StringFormat='Mevcut Ölçek: {0:P0}'}" FontSize="14" FontWeight="Bold" Foreground="#10b981"/>
                            </StackPanel>
                        </Border>
 
                        <!-- Section: Notifications -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='notifications'}">
                            <StackPanel Spacing="30" Width="850" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Alert" FontSize="24" Foreground="#F59E0B"/> 
                                    <TextBlock Text="Bildirim Ayarları" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <ScrollViewer MaxHeight="550" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="20">
                                        <!-- GROUP 1: FİNANSAL UYARILAR -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="20">
                                            <StackPanel Spacing="15">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ic:SymbolIcon Symbol="Money" FontSize="20" Foreground="#60A5FA"/>
                                                    <TextBlock Text="Finansal Uyarılar" FontSize="16" FontWeight="Bold" Foreground="#60A5FA"/>
                                                </StackPanel>
                                                <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                                                <!-- Vadesi Geçen Alacaklar -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Vadesi Geçen Alacak Uyarılarını Göster" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Ödeme tarihi geçmiş ve ödenmemiş faturaları bildirir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableOverdueAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Yaklaşan Vade Sınırı -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Vade Yaklaşma Uyarısı Eşik Günü" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Fatura vadesine belirtilen gün kadar kaldığında uyarı üretilir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <NumericUpDown Grid.Column="1" Value="{Binding OverdueDaysThreshold, Mode=TwoWay}" Minimum="0" Maximum="30" Width="130" FormatString="0 Gün" CornerRadius="8"/>
                                                </Grid>

                                                <!-- Çek / Senet Vade Uyarıları -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Çek ve Senet Vade Hatırlatıcısı" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Vadesine 2 gün kalan portföydeki evraklar için uyarı üretir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableChequeSenetAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Cari Risk Limiti Aşımları -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Cari Risk Limiti Aşım Uyarıları" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Müşterinin toplam borcu, kartındaki limiti aştığında uyarı verir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRiskLimitAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Bakiye Yaşlandırma -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Bakiye Yaşlandırma Bildirimleri" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="30, 60 veya 90 günü aşan vadesi geçmiş borçları raporlar." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAgingDebtAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Gün Sonu Giriş Özeti -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Günlük Finansal Durum Özeti (Gün Sonu / Giriş)" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="İlk açılışta veya gün kapanışında toplam ciro, tahsilat ve kasa durumunu bildirir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableDailySummaryAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- GROUP 2: STOK UYARILARI -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="20">
                                            <StackPanel Spacing="15">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ic:SymbolIcon Symbol="Box" FontSize="20" Foreground="#10B981"/>
                                                    <TextBlock Text="Stok ve Envanter Uyarıları" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                                </StackPanel>
                                                <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                                                <!-- Düşük Stok -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Düşük Stok Bildirimlerini Göster" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Kritik seviyenin altına düşen ürünleri haber verir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableLowStockAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Negatif Stok -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Negatif Stok (Eksi Bakiye) Uyarısı" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Miktarı sıfırın altına düşmüş ürünlerde anlık uyarı üretir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNegativeStockAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- GROUP 3: SİSTEM UYARILARI -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="20">
                                            <StackPanel Spacing="15">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ic:SymbolIcon Symbol="Desktop" FontSize="20" Foreground="#EC4899"/>
                                                    <TextBlock Text="Sistem ve Entegrasyon Uyarıları" FontSize="16" FontWeight="Bold" Foreground="#EC4899"/>
                                                </StackPanel>
                                                <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                                                <!-- Otomatik Yedekleme -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Yedekleme Durumlarını Bildir" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Günlük otomatik yedekleme başarılı/başarısız olduğunda uyarır." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableBackupAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Bulut Senkronizasyon -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Bulut Veritabanı ve Ağ Hatası Bildirimleri" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Bağlantı koptuğunda veya eşitlemede hata çıktığında bildirim gönderir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCloudSyncAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>

                                                <!-- Windows Toast Uyarısı -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="Windows Masaüstü Balon Bildirimleri" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Uygulama arka plandayken bile sağ altta sistem bildirimleri gösterir." FontSize="11" Opacity="0.6"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableWindowsToastAlert, Mode=TwoWay}" OnContent="Açık" OffContent="Kapalı"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <Button Command="{Binding SaveSettingsCommand}" Content="Bildirim Ayarlarını Kaydet" Classes="Primary" Height="54" Padding="50,0" CornerRadius="15" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
 
                        <!-- Section: Advanced -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="20" Padding="30" IsVisible="{Binding CurrentCategory.Id, Converter={StaticResource StringEqualsConverter}, ConverterParameter='advanced'}">
                            <StackPanel Spacing="30" MaxWidth="1000" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Wrench" FontSize="24" Foreground="#ef4444"/> 
                                    <TextBlock Text="Gelişmiş Sistem İşlemleri" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <!-- Factory Reset Box -->
                                <Border Background="rgba(239, 68, 68, 0.15)" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="15" Padding="25">
                                    <StackPanel Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="Warning" FontSize="28" Foreground="#ef4444"/>
                                            <TextBlock Text="Fabrika Ayarlarına Dön" FontSize="20" FontWeight="Black" Foreground="#ef4444" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Bu işlem tüm verileri, kayıtları ve yapılandırmaları kalıcı olarak silecektir! Bu işlemin geri dönüşü mümkün değildir." FontSize="14" Foreground="#ef4444" Opacity="0.9" TextWrapping="Wrap"/>
                                        <TextBlock Text="Kurulum esnasında belirlediğiniz Fabrika Ayarları Sıfırlama Onay Şifresini girmelisiniz." FontSize="13" FontWeight="Black" Foreground="#ef4444" Opacity="0.8"/>
                                        
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="20">
                                            <TextBox Grid.Column="0" PasswordChar="*" Watermark="Sıfırlama Onay Şifresini Yazın" Text="{Binding ResetPassword}" Height="55" CornerRadius="12" BorderBrush="#ef4444"/>
                                            <Button Grid.Column="1" Command="{Binding FactoryResetCommand}" Classes="Danger" Height="55" Padding="40,0" CornerRadius="12">
                                                <TextBlock Text="SİSTEMİ TAMAMEN SIFIRLA" FontWeight="Black" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Separator Background="{DynamicResource BorderColor}" Margin="0,15"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="AppsList" FontSize="24" Foreground="#10B981"/> 
                                    <TextBlock Text="Gelişmiş Araçlar ve Teşhis Merkezi" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Sisteminizi optimize etmek ve sorunları tespit etmek için bu araçları kullanabilirsiniz." FontSize="13" Foreground="#94a3b8" Margin="0,-5,0,10"/>

                                <!-- Performans ve Konfigürasyon Toggles -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="20" Margin="0,0,0,15">
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Düşük Donanım (Performans) Modu" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Animasyonları ve görsel efektleri kapatır." FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LowPerformanceMode, Mode=TwoWay}" OnContent="" OffContent=""/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="15">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Bulut Yedekleme Entegrasyonu" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Yedekleri yapılandırılan bulut servisine de kopyalar." FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloudBackupIntegration, Mode=TwoWay}" OnContent="" OffContent=""/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Otomatik Yedekleme Konumu Belirleme -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="25" Margin="0,0,0,15" MaxWidth="1000">
                                    <StackPanel Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="Folder" FontSize="24" Foreground="#8b5cf6"/>
                                            <TextBlock Text="Otomatik Yedekleme Klasörü" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Sistemin günlük otomatik yedekleri kaydedeceği klasörü belirleyin. Boş bırakılırsa varsayılan AppData klasörü kullanılır." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,5,0,0">
                                            <TextBox Grid.Column="0" Text="{Binding BackupFolderPath}" Watermark="Varsayılan yedekleme klasörü aktif..." IsReadOnly="True" CornerRadius="10" Height="45"/>
                                            <Button Grid.Column="1" Command="{Binding SelectBackupFolderCommand}" Content="Klasör Seç" Classes="Primary" CornerRadius="10" Height="45"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,0,0,0" MaxWidth="1000">
                                    <Button Command="{Binding RunDiagnosticCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Stethoscope" FontSize="28" Foreground="#10b981" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Dosya Bütünlük Testi" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Sistem ve veritabanı sağlık taraması" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding OpenRecycleBinCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Delete" FontSize="28" Foreground="#f59e0b" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Silinmiş Kayıtlar Yöneticisi" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Çöp kutusuna alınan kayıtları kurtarın" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding OpenAutoBackupCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Timer" FontSize="28" Foreground="#8b5cf6" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Otomatik Yedekleme" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Zamanlanmış arka plan yedeklemeleri" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding OpenCronManagerCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="CalendarClock" FontSize="28" Foreground="#6366f1" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Zamanlanmış Görevler" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Cron işlerini ve tetikleyicileri ayarlayın" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding RunYearEndSimulatorCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Beaker" FontSize="28" Foreground="#14b8a6" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Yıl Sonu Devir Simülatörü" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Devir işlemini sanal olarak test edin" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding RunDocNumberDiagnosticsCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="DocumentSearch" FontSize="28" Foreground="#f97316" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Evrak Numarası Teşhisi" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Atlanmış/mükerrer fatura no kontrolü" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding RunNetworkDiagnosticCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Globe" FontSize="28" Foreground="#06b6d4" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Ağ ve Bağlantı Hız Testi" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Sunucu gecikme ve bağlantı analizi" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding OpenSmtpSettingsCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Mail" FontSize="28" Foreground="#a855f7" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="E-Posta (SMTP) Ayarları" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="E-posta gönderim sunucusu ve hesap ayarları" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Command="{Binding OpenShortcutsManagerCommand}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Width="300" Height="80" Margin="0,0,15,15" Padding="15">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <ic:SymbolIcon Grid.Column="0" Symbol="Keyboard" FontSize="28" Foreground="#ec4899" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Özel Klavye Kısayolları" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Sık kullanılan işlemler için kısayollar" FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </WrapPanel>

                                <!-- SMTP E-posta Ayarları Paneli -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="25" Margin="0,10,0,0" IsVisible="{Binding ShowSmtpSettings}">
                                    <StackPanel Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="Mail" FontSize="24" Foreground="#a855f7"/>
                                            <TextBlock Text="E-Posta (SMTP) Sunucu Ayarları" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Fatura ve ekstreleri e-posta ile gönderebilmek için SMTP posta sunucunuzu tanımlayın." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                        
                                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="15" ColumnSpacing="15">
                                            <!-- SMTP Host -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                                                <TextBlock Text="SMTP Sunucu Adresi (Host)" FontSize="12" Foreground="#94a3b8"/>
                                                <TextBox Text="{Binding SmtpHost}" Watermark="Örn: smtp.gmail.com" CornerRadius="8" Height="40"/>
                                            </StackPanel>
                                            
                                            <!-- SMTP Port -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                                <TextBlock Text="SMTP Port" FontSize="12" Foreground="#94a3b8"/>
                                                <TextBox Text="{Binding SmtpPort}" Watermark="Örn: 587" CornerRadius="8" Height="40"/>
                                            </StackPanel>
                                            
                                            <!-- SMTP User -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                                <TextBlock Text="E-posta Kullanıcı Adı (Username)" FontSize="12" Foreground="#94a3b8"/>
                                                <TextBox Text="{Binding SmtpUser}" Watermark="Örn: eposta@adresiniz.com" CornerRadius="8" Height="40"/>
                                            </StackPanel>
                                            
                                            <!-- SMTP Password -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                                                <TextBlock Text="Şifre (Password)" FontSize="12" Foreground="#94a3b8"/>
                                                <TextBox Text="{Binding SmtpPass}" PasswordChar="*" Watermark="E-posta şifreniz" CornerRadius="8" Height="40"/>
                                            </StackPanel>

                                            <!-- SMTP SSL & Test Button -->
                                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="SSL / TLS Güvenli Bağlantı" FontSize="13" VerticalAlignment="Center"/>
                                                    <ToggleSwitch IsChecked="{Binding SmtpSsl}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding SendTestEmailCommand}" Content="Test E-postası Gönder" Classes="Secondary" CornerRadius="8" Height="40" Padding="15,0"/>
                                            </Grid>
                                        </Grid>

                                        <!-- IMAP Sunucu Ayarları Separator -->
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,15"/>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="FolderArrowRight" FontSize="24" Foreground="#ec4899"/>
                                            <TextBlock Text="Gönderilen Kutusu Arşivleme Ayarları (IMAP)" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Gönderdiğiniz fatura ve ekstrelerin e-posta kutunuzun 'Gönderilenler' (Sent) klasörüne kaydedilmesi için IMAP ayarlarını yapın." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        
                                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="15" ColumnSpacing="15">
                                            <!-- IMAP Host -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                                                <TextBlock Text="IMAP Sunucu Adresi (Host)" FontSize="12" Foreground="#94a3b8"/>
                                                <TextBox Text="{Binding ImapHost}" Watermark="Örn: imap.gmail.com" CornerRadius="8" Height="40"/>
                                            </StackPanel>
                                            
                                            <!-- IMAP Port -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                                <TextBlock Text="IMAP Port" FontSize="12" Foreground="#94a3b8"/>
                                                <TextBox Text="{Binding ImapPort}" Watermark="Örn: 993" CornerRadius="8" Height="40"/>
                                            </StackPanel>

                                            <!-- IMAP SSL -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,10,0,0">
                                                <TextBlock Text="SSL / TLS Güvenli Bağlantı" FontSize="13" VerticalAlignment="Center"/>
                                                <ToggleSwitch IsChecked="{Binding ImapSsl}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Recycle Bin Panel -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="25" Margin="0,10,0,0" IsVisible="{Binding ShowRecycleBin}">
                                    <StackPanel Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="Delete" FontSize="24" Foreground="#f59e0b"/>
                                            <TextBlock Text="Silinmiş Kayıtlar Yöneticisi" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Silinen kayıtlarınız tamamen yok olmaz, çöp kutusunda tutulur." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                        
                                        <ListBox ItemsSource="{Binding DeletedItems}" Background="Transparent" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#f59e0b" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        
                                        <Button Command="{Binding RestoreDeletedItemsCommand}" Content="Tümünü Kurtar" Classes="Warning" CornerRadius="10" HorizontalAlignment="Right" IsEnabled="{Binding !IsBusy}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cron Manager Panel -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="25" Margin="0,10,0,0" IsVisible="{Binding ShowCronManager}">
                                    <StackPanel Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="CalendarClock" FontSize="24" Foreground="#6366f1"/>
                                            <TextBlock Text="Zamanlanmış Görevler (Cron)" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Arka planda çalışan periyodik işlemleri buradan görebilirsiniz." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                        
                                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Otomatik Günlük Yedekleme" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Her gün saat 18:00'da tetiklenir." FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="18:00" Foreground="#6366f1" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <ToggleSwitch Grid.Column="2" IsChecked="True" IsEnabled="False" OnContent="Aktif" OffContent="Pasif"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Düşük Stok Kontrolü" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Uygulama açıldığında çalışır." FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Açılışta" Foreground="#10b981" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <ToggleSwitch Grid.Column="2" IsChecked="True" IsEnabled="False" OnContent="Aktif" OffContent="Pasif"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Shortcuts Manager Panel -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="15" Padding="25" Margin="0,10,0,0" IsVisible="{Binding ShowShortcutsManager}">
                                    <StackPanel Spacing="15">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ic:SymbolIcon Symbol="Keyboard" FontSize="24" Foreground="#ec4899"/>
                                            <TextBlock Text="Özel Klavye Kısayolları" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Sık kullandığınız pencerelere global olarak hangi tuşlarla ulaşabileceğinizi ayarlayın." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                        
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,5"/>
                                        
                                        <Grid ColumnDefinitions="*, 200" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Yeni Satış Faturası Ekle" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShortcutKeysList}" SelectedItem="{Binding ShortcutNewInvoice, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="*, 200" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Yeni Cari Kart Ekle" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShortcutKeysList}" SelectedItem="{Binding ShortcutNewCari, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 200" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Yeni Stok Kartı Ekle" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShortcutKeysList}" SelectedItem="{Binding ShortcutNewStok, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 200" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Faturalar Listesini Aç" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShortcutKeysList}" SelectedItem="{Binding ShortcutOpenFaturalar, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 200" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Cari Hesaplar Listesini Aç" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShortcutKeysList}" SelectedItem="{Binding ShortcutOpenCariler, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, 200" Margin="0,5">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Raporlar Ekranını Aç" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                             <ComboBox Grid.Column="1" ItemsSource="{Binding ShortcutKeysList}" SelectedItem="{Binding ShortcutOpenRaporlar, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
    
                    </StackPanel>
                </Panel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

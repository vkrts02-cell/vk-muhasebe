<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="ErmayMuhasebe.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <Style Selector="Button.LinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                     Content="{TemplateBinding Content}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LinkButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BackgroundBrush}" Padding="40">
        <StackPanel VerticalAlignment="Center" Spacing="20" MaxWidth="350">

            <Image Source="avares://ErmayMuhasebe.Avalonia/Assets/vk_logo.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

            <TextBlock Text="VK" 
                       FontSize="28" 
                       FontWeight="ExtraBold" 
                       LetterSpacing="2"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
            
            <TextBlock Text="Ön Muhasebe &amp; Finans Yönetimi" 
                       FontSize="13" 
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>

            <!-- Giriş Formu Alanı -->
            <StackPanel Spacing="10" Margin="0,15,0,0">
                <TextBlock Text="Kullanıcı Adı" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                <TextBox Text="{Binding Username}" 
                         Watermark="Kullanıcı adınızı girin"
                         Height="40"
                         VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Şifre" FontWeight="SemiBold" FontSize="12" Opacity="0.8" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Password}" 
                         PasswordChar="*"
                         Watermark="••••••••"
                         Height="40"
                         VerticalContentAlignment="Center"
                         KeyDown="Password_KeyDown"/>

                <CheckBox Content="Beni Hatırla" 
                          IsChecked="{Binding RememberMe}"
                          Margin="0,10,0,12"
                          FontSize="13" 
                          Cursor="Hand"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>


            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#EF4444" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Text="{Binding SuccessMessage}" 
                       Foreground="#4ADE80" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Button Command="{Binding LoginCommand}" 
                    Content="Giriş Yap" 
                    Background="#2563EB" 
                    Foreground="White" 
                    Height="45"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontWeight="Bold"
                    IsEnabled="{Binding !IsBusy}">
                <Button.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Button.Transitions>
            </Button>

            <Grid ColumnDefinitions="*,Auto,*" Margin="0,5,0,5">
                <Rectangle Grid.Column="0" Height="1" Fill="#334155" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="veya" FontSize="11" Foreground="#64748B" Margin="10,0"/>
                <Rectangle Grid.Column="2" Height="1" Fill="#334155" VerticalAlignment="Center"/>
            </Grid>

            <Button Command="{Binding LoginWithGoogleCommand}" 
                    Background="#1E293B" 
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Foreground="White" 
                    Height="45"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontWeight="SemiBold"
                    IsEnabled="{Binding !IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="#EA4335" 
                          Data="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5zm11 7c0-.8-.1-1.6-.2-2.3H12v4.5h6.3c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.4-5 3.4-8.8zm-11 11c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 16.4C3.7 20.2 7.5 23 12 23zM5.6 14.2c-.2-.7-.4-1.4-.4-2.2s.2-1.5.4-2.2L1.9 6.9C1.2 8.4.8 10.1.8 12s.4 3.6 1.1 5.1l3.7-2.9z"/>
                    <TextBlock Text="Google ile Giriş Yap" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Button>

            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsBusy}" 
                         Height="2" 
                         Margin="0,-5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>

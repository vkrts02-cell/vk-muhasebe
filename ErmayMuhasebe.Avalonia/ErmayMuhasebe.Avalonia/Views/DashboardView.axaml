<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:converters="clr-namespace:ErmayMuhasebe.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="ErmayMuhasebe.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Resources>
     <converters:BakiyeToStatusBrushConverter x:Key="BakiyeBrush"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Karlılık Dynamic Colors -->
    <Style Selector="Border.ProfitCard">
      <Setter Property="Background" Value="#2A34D399"/>
      <Setter Property="BorderBrush" Value="#34D399"/>
    </Style>
    <Style Selector="Border.LossCard">
      <Setter Property="Background" Value="#2AF87171"/>
      <Setter Property="BorderBrush" Value="#F87171"/>
    </Style>
    
    <Style Selector="ic|SymbolIcon.ProfitIcon">
      <Setter Property="Symbol" Value="ArrowCircleUp"/>
      <Setter Property="Foreground" Value="#34D399"/>
    </Style>
    <Style Selector="ic|SymbolIcon.LossIcon">
      <Setter Property="Symbol" Value="ArrowCircleDown"/>
      <Setter Property="Foreground" Value="#F87171"/>
    </Style>
  </UserControl.Styles>

  <Grid>
     <!-- MODERN SAAS: Warm & Vibrant Design -->
     <Grid IsVisible="{Binding IsModernSaaS}">
         
         <!-- Main Content Area -->
         <Border Padding="30">
             <Grid RowDefinitions="Auto, Auto, *" RowSpacing="15">
                 
                 <!-- 1. Quick Actions Row (Warm & Energetic Gradients) -->
                 <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,-10,0">
                      <!-- Alış (Vibrant Orange) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Alis" Height="70" Margin="0,0,10,0" HorizontalAlignment="Stretch" CornerRadius="16">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#EF4444" Offset="0"/>
                                  <GradientStop Color="#DC2626" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#50FFFFFF">
                                  <ic:SymbolIcon Symbol="Cart" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                  <TextBlock Text="Alış" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Fatura Girişi" FontSize="11" Foreground="White" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
 
                      <!-- Satış (Neon Emerald) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Satis" Height="70" Margin="0,0,10,0" HorizontalAlignment="Stretch" CornerRadius="16">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#10B981" Offset="0"/>
                                  <GradientStop Color="#059669" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#50FFFFFF">
                                  <ic:SymbolIcon Symbol="Tag" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                  <TextBlock Text="Satış" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Yeni Satış" FontSize="11" Foreground="White" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
                      
                       <!-- Sipariş (Hot Rose/Purple) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Siparis" Height="70" Margin="0,0,10,0" HorizontalAlignment="Stretch" CornerRadius="16">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#F97316" Offset="0"/>
                                  <GradientStop Color="#EA580C" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#50FFFFFF">
                                  <ic:SymbolIcon Symbol="ClipboardText" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                  <TextBlock Text="Sipariş" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Sipariş Yaz" FontSize="11" Foreground="White" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
 
                       <!-- Teklif (Golden Amber) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Teklif" Height="70" Margin="0,0,10,0" HorizontalAlignment="Stretch" CornerRadius="16">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#007acc" Offset="0"/>
                                  <GradientStop Color="#005a9e" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#50FFFFFF">
                                  <ic:SymbolIcon Symbol="DocumentPercent" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                  <TextBlock Text="Teklif" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Teklif Hazırla" FontSize="11" Foreground="White" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
                 </UniformGrid>

                  <!-- 2. Stats Cards (Warm Borders & High Contrast) -->
                  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-10,0">
                      <!-- Gunluk Ciro (Warm Gold Glow) -->
                      <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="#FACC15" BorderThickness="2" CornerRadius="20" Padding="15,12" Margin="0,0,10,0" Height="80" BoxShadow="0 4 15 0 #20FACC15">
                           <Grid ColumnDefinitions="Auto, *">
                               <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#2AFACC15">
                                   <ic:SymbolIcon Symbol="Wallet" Foreground="#FACC15" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="{Binding GunlukSatis, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="Günlük Ciro" FontSize="12" Foreground="#FACC15" FontWeight="Black"/>
                                </StackPanel>
                           </Grid>
                      </Border>
                      
                      <!-- Toplam Alacak (Vibrant Sky Glow) -->
                      <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="#0EA5E9" BorderThickness="2" CornerRadius="20" Padding="15,12" Margin="0,0,10,0" Height="80" BoxShadow="0 4 15 0 #200EA5E9">
                           <Grid ColumnDefinitions="Auto, *">
                               <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#2A0EA5E9">
                                   <ic:SymbolIcon Symbol="ArrowTrendingLines" Foreground="#0EA5E9" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="{Binding ToplamAlacak, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="Toplam Alacak" FontSize="12" Foreground="#0EA5E9" FontWeight="Black"/>
                                </StackPanel>
                           </Grid>
                      </Border>
   
                       <!-- Toplam Borc (Hot Red Glow) -->
                      <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="20" Padding="15,12" Margin="0,0,10,0" Height="80" BoxShadow="0 4 15 0 #20EF4444">
                           <Grid ColumnDefinitions="Auto, *">
                               <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#2AEF4444">
                                   <ic:SymbolIcon Symbol="Warning" Foreground="#EF4444" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="{Binding ToplamBorc, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="Toplam Borç" FontSize="12" Foreground="#EF4444" FontWeight="Black"/>
                                </StackPanel>
                           </Grid>
                      </Border>

                      <!-- Net Bakiye Durumu (Yeşil: +Alacak Fazlası, Kırmızı: -Borç Fazlası) -->
                      <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{Binding NetColorBrush}" BorderThickness="2" CornerRadius="20" Padding="15,12" Margin="0,0,10,0" Height="80" BoxShadow="{Binding NetBoxShadow}">
                           <Grid ColumnDefinitions="Auto, *">
                               <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="{Binding NetBgBrush}">
                                   <ic:SymbolIcon Symbol="Money" Foreground="{Binding NetColorBrush}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="{Binding NetBakiyeText}" FontSize="22" FontWeight="Black" Foreground="{Binding NetColorBrush}"/>
                                    <TextBlock Text="Net" FontSize="12" Foreground="{Binding NetColorBrush}" FontWeight="Black"/>
                                </StackPanel>
                           </Grid>
                      </Border>
                  </UniformGrid>
                 
                 <!-- 3. Lower Section: Chart & Functional Lists -->
                 <Grid Grid.Row="2" ColumnDefinitions="6*, 4*">
                     <!-- Chart Section (Vibrant Header) -->
                     <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="24" Padding="25" Margin="0,0,20,0">
                         <Grid RowDefinitions="Auto, *">
                             <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                                 <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                     <Border Background="#2A10B981" Width="40" Height="40" CornerRadius="12">
                                         <ic:SymbolIcon Symbol="Target" Foreground="#10B981" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                     <TextBlock Text="Hedef &amp; Gerçekleşme" FontSize="22" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                 </StackPanel>
                                 
                                 <Border Grid.Column="1" Background="#333" CornerRadius="12" Padding="4" HorizontalAlignment="Right">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                         <Button Command="{Binding ToggleGoalPeriodCommand}" CommandParameter="Weekly"
                                                 Background="{Binding IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Background}" 
                                                 BorderThickness="0" CornerRadius="10" Width="80" Height="36">
                                             <TextBlock Text="Hafta" FontSize="14" Foreground="{Binding IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Foreground}" FontWeight="Black" HorizontalAlignment="Center"/>
                                         </Button>
                                         <Button Command="{Binding ToggleGoalPeriodCommand}" CommandParameter="Monthly"
                                                 Background="{Binding !IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Background}"
                                                 BorderThickness="0" CornerRadius="10" Width="80" Height="36">
                                             <TextBlock Text="Ay" FontSize="14" Foreground="{Binding !IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Foreground}" FontWeight="Black" HorizontalAlignment="Center"/>
                                         </Button>
                                     </StackPanel>
                                 </Border>
                             </Grid>
                             <lvc:CartesianChart Grid.Row="1" Series="{Binding TargetVsActualSeries}" XAxes="{Binding TargetVsActualXAxis}" YAxes="{Binding TargetVsActualYAxis}"/>
                         </Grid>
                     </Border>
 
                     <!-- Tabs Section (Vibrant & Warm Items) -->
                     <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" CornerRadius="24" Padding="12">
                         <TabControl>
                             <TabControl.Styles>
                                 <Style Selector="TabItem">
                                     <Setter Property="FontSize" Value="15"/>
                                     <Setter Property="FontWeight" Value="Black"/>
                                     <Setter Property="Padding" Value="15,12"/>
                                 </Style>
                             </TabControl.Styles>
                             
                             <TabItem Header="Son İşlemler">
                                 <ScrollViewer Margin="0,15,0,0">
                                     <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="14" Padding="15,12" Margin="0,0,10,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                     <Grid ColumnDefinitions="*, Auto">
                                                         <StackPanel Grid.Column="0" Spacing="3">
                                                             <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="Black"/>
                                                             <TextBlock Text="{Binding Description}" Foreground="#BBB" FontSize="12"/>
                                                         </StackPanel>
                                                         <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                             <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} ₺'}" Foreground="{Binding TextColor, FallbackValue=White}" FontWeight="Black" FontSize="18" HorizontalAlignment="Right"/>
                                                             <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="#888" FontSize="11" HorizontalAlignment="Right"/>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>
 
                             <TabItem Header="Alacak Takibi">
                                 <ScrollViewer Margin="0,15,0,0">
                                     <ItemsControl ItemsSource="{Binding RiskyCaris}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="14" Padding="15,12" Margin="0,0,10,10" BorderBrush="#0EA5E9" BorderThickness="1,1,1,4">
                                                     <Grid>
                                                         <StackPanel>
                                                             <TextBlock Text="{Binding Unvan}" Foreground="White" FontWeight="Black" FontSize="14" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                                                 <TextBlock Text="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Foreground="#0EA5E9" FontSize="18" FontWeight="Black"/>
                                                                 <Border Background="#2A0EA5E9" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                     <TextBlock Text="{Binding OrtalamaVade, StringFormat='{}{0} G'}" Foreground="#0EA5E9" FontSize="11" FontWeight="Black"/>
                                                                 </Border>
                                                             </StackPanel>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>
 
                             <TabItem Header="Borç Takibi">
                                 <ScrollViewer Margin="0,15,0,0">
                                     <ItemsControl ItemsSource="{Binding PayableCaris}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="14" Padding="15,12" Margin="0,0,10,10" BorderBrush="#EF4444" BorderThickness="1,1,1,4">
                                                     <Grid ColumnDefinitions="*, Auto">
                                                         <StackPanel>
                                                             <TextBlock Text="{Binding Unvan}" Foreground="White" FontWeight="Black" FontSize="14" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                                                 <TextBlock Text="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Foreground="#EF4444" FontSize="18" FontWeight="Black"/>
                                                                 <Border Background="#2AEF4444" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                     <TextBlock Text="{Binding OrtalamaVade, StringFormat='{}{0} G'}" Foreground="#EF4444" FontSize="11" FontWeight="Black"/>
                                                                 </Border>
                                                             </StackPanel>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>
                         </TabControl>
                     </Border>
                 </Grid>
             </Grid>
         </Border>
     </Grid>

    
     <!-- =========================================================================
          1. OBSIDIAN GLOW: Ultra-Modern Dark Luxury, Neon Turkuaz & Çivit Mavi
          ========================================================================= -->
     <Grid IsVisible="{Binding IsObsidianGlow}">
         <Border Padding="26">
             <Grid RowDefinitions="Auto, Auto, *" RowSpacing="18">
                 
                 <!-- 1. Quick Actions Floating Dock (Neon Glow) -->
                 <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,-12,0">
                      <!-- Alış (Neon Rose / Crimson) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Alis" Height="72" Margin="0,0,12,0" HorizontalAlignment="Stretch" CornerRadius="16" BorderBrush="#55F43F5E" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#1A0D15" Offset="0"/>
                                  <GradientStop Color="#2A121E" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#30F43F5E">
                                  <ic:SymbolIcon Symbol="Cart" Foreground="#F43F5E" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Alış" FontSize="16" FontWeight="Black" Foreground="#FFF"/>
                                  <TextBlock Text="Fatura Girişi" FontSize="11" Foreground="#F43F5E" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
 
                      <!-- Satış (Neon Turkuaz -> Çivit Degrade) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Satis" Height="72" Margin="0,0,12,0" HorizontalAlignment="Stretch" CornerRadius="16" BorderBrush="#8000E5FF" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#00E5FF" Offset="0"/>
                                  <GradientStop Color="#6366F1" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#35FFFFFF">
                                  <ic:SymbolIcon Symbol="Tag" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Satış" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Hızlı Satış" FontSize="11" Foreground="White" Opacity="0.95"/>
                              </StackPanel>
                          </Grid>
                      </Button>
                      
                      <!-- Sipariş (Neon Emerald) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Siparis" Height="72" Margin="0,0,12,0" HorizontalAlignment="Stretch" CornerRadius="16" BorderBrush="#5510B981" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#0D1815" Offset="0"/>
                                  <GradientStop Color="#12251F" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#3010B981">
                                  <ic:SymbolIcon Symbol="ClipboardText" Foreground="#10B981" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Sipariş" FontSize="16" FontWeight="Black" Foreground="#FFF"/>
                                  <TextBlock Text="Sipariş Yaz" FontSize="11" Foreground="#10B981" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
 
                      <!-- Teklif (Electric Violet) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Teklif" Height="72" Margin="0,0,12,0" HorizontalAlignment="Stretch" CornerRadius="16" BorderBrush="#558B5CF6" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#141022" Offset="0"/>
                                  <GradientStop Color="#1E1635" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#308B5CF6">
                                  <ic:SymbolIcon Symbol="DocumentPercent" Foreground="#8B5CF6" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Teklif" FontSize="16" FontWeight="Black" Foreground="#FFF"/>
                                  <TextBlock Text="Teklif Hazırla" FontSize="11" Foreground="#8B5CF6" Opacity="0.9"/>
                              </StackPanel>
                          </Grid>
                      </Button>
                 </UniformGrid>

                 <!-- 2. Neon Glowing KPI Cards -->
                 <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,0">
                     <!-- Günlük Ciro (Neon Gold Glow) -->
                     <Border Background="#0E141E" BorderBrush="#FACC15" BorderThickness="1.5" CornerRadius="18" Padding="18,14" Margin="0,0,12,0" Height="84" BoxShadow="0 0 16 0 #25FACC15, 0 8 24 0 #60000000">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#2AFACC15">
                                  <ic:SymbolIcon Symbol="Wallet" Foreground="#FACC15" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding GunlukSatis, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="GÜNLÜK CİRO" FontSize="11" Foreground="#FACC15" FontWeight="Bold" LetterSpacing="1"/>
                              </StackPanel>
                          </Grid>
                     </Border>
                     
                     <!-- Toplam Alacak (Neon Cyan Glow) -->
                     <Border Background="#0E141E" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="18" Padding="18,14" Margin="0,0,12,0" Height="84" BoxShadow="0 0 18 0 #3000E5FF, 0 8 24 0 #60000000">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#2A00E5FF">
                                  <ic:SymbolIcon Symbol="ArrowTrendingLines" Foreground="#00E5FF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding ToplamAlacak, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="TOPLAM ALACAK" FontSize="11" Foreground="#00E5FF" FontWeight="Bold" LetterSpacing="1"/>
                              </StackPanel>
                          </Grid>
                     </Border>
  
                     <!-- Toplam Borç (Neon Rose Glow) -->
                     <Border Background="#0E141E" BorderBrush="#F43F5E" BorderThickness="1.5" CornerRadius="18" Padding="18,14" Margin="0,0,12,0" Height="84" BoxShadow="0 0 18 0 #30F43F5E, 0 8 24 0 #60000000">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#2AF43F5E">
                                  <ic:SymbolIcon Symbol="Warning" Foreground="#F43F5E" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding ToplamBorc, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="TOPLAM BORÇ" FontSize="11" Foreground="#F43F5E" FontWeight="Bold" LetterSpacing="1"/>
                              </StackPanel>
                          </Grid>
                     </Border>

                     <!-- Net Bakiye -->
                     <Border Background="#0E141E" BorderBrush="{Binding NetColorBrush}" BorderThickness="1.5" CornerRadius="18" Padding="18,14" Margin="0,0,12,0" Height="84" BoxShadow="{Binding NetBoxShadow}">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="{Binding NetBgBrush}">
                                  <ic:SymbolIcon Symbol="Money" Foreground="{Binding NetColorBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding NetBakiyeText}" FontSize="22" FontWeight="Black" Foreground="{Binding NetColorBrush}"/>
                                  <TextBlock Text="NET DURUM" FontSize="11" Foreground="{Binding NetColorBrush}" FontWeight="Bold" LetterSpacing="1"/>
                              </StackPanel>
                          </Grid>
                     </Border>
                 </UniformGrid>
                
                 <!-- 3. Lower Section: Obsidian Chart & Lists -->
                 <Grid Grid.Row="2" ColumnDefinitions="6*, 4*">
                     <!-- Chart Section -->
                     <Border Grid.Column="0" Background="#0E141E" BorderBrush="#4000E5FF" BorderThickness="1.5" CornerRadius="22" Padding="24" Margin="0,0,18,0" BoxShadow="0 10 32 0 #70000000">
                         <Grid RowDefinitions="Auto, *">
                             <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                                 <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                     <Border Background="#2500E5FF" Width="40" Height="40" CornerRadius="12">
                                         <ic:SymbolIcon Symbol="Target" Foreground="#00E5FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                     <TextBlock Text="Hedef &amp; Gerçekleşme" FontSize="20" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                 </StackPanel>
                                 
                                 <Border Grid.Column="1" Background="#07090E" BorderBrush="#3000E5FF" BorderThickness="1" CornerRadius="12" Padding="4" HorizontalAlignment="Right">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                         <Button Command="{Binding ToggleGoalPeriodCommand}" CommandParameter="Weekly"
                                                 Background="{Binding IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Background}" 
                                                 BorderThickness="0" CornerRadius="10" Width="80" Height="34">
                                             <TextBlock Text="Hafta" FontSize="13" Foreground="{Binding IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Foreground}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                         </Button>
                                         <Button Command="{Binding ToggleGoalPeriodCommand}" CommandParameter="Monthly"
                                                 Background="{Binding !IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Background}"
                                                 BorderThickness="0" CornerRadius="10" Width="80" Height="34">
                                             <TextBlock Text="Ay" FontSize="13" Foreground="{Binding !IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Foreground}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                         </Button>
                                     </StackPanel>
                                 </Border>
                             </Grid>
                             <lvc:CartesianChart Grid.Row="1" Series="{Binding TargetVsActualSeries}" XAxes="{Binding TargetVsActualXAxis}" YAxes="{Binding TargetVsActualYAxis}"/>
                         </Grid>
                     </Border>

                     <!-- Tabs Section -->
                     <Border Grid.Column="1" Background="#0E141E" BorderBrush="#4000E5FF" BorderThickness="1.5" CornerRadius="22" Padding="14" BoxShadow="0 10 32 0 #70000000">
                         <TabControl>
                             <TabControl.Styles>
                                 <Style Selector="TabItem">
                                     <Setter Property="FontSize" Value="14"/>
                                     <Setter Property="FontWeight" Value="Bold"/>
                                     <Setter Property="Padding" Value="14,10"/>
                                 </Style>
                             </TabControl.Styles>
                             
                             <TabItem Header="Son İşlemler">
                                 <ScrollViewer Margin="0,12,0,0">
                                     <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="#07090E" CornerRadius="14" Padding="14,12" Margin="0,0,10,8" BorderBrush="#2500E5FF" BorderThickness="1">
                                                     <Grid ColumnDefinitions="*, Auto">
                                                         <StackPanel Grid.Column="0" Spacing="3">
                                                             <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                             <TextBlock Text="{Binding Description}" Foreground="#8B949E" FontSize="11"/>
                                                         </StackPanel>
                                                         <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                             <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} ₺'}" Foreground="{Binding TextColor, FallbackValue='#00E5FF'}" FontWeight="Black" FontSize="17" HorizontalAlignment="Right"/>
                                                             <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="#6E7681" FontSize="10" HorizontalAlignment="Right"/>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>

                             <TabItem Header="Alacak Takibi">
                                 <ScrollViewer Margin="0,12,0,0">
                                     <ItemsControl ItemsSource="{Binding RiskyCaris}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="#07090E" CornerRadius="14" Padding="14,12" Margin="0,0,10,8" BorderBrush="#00E5FF" BorderThickness="1,1,1,3">
                                                     <Grid>
                                                         <StackPanel>
                                                             <TextBlock Text="{Binding Unvan}" Foreground="White" FontWeight="Bold" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                                 <TextBlock Text="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Foreground="#00E5FF" FontSize="17" FontWeight="Black"/>
                                                                 <Border Background="#2500E5FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                     <TextBlock Text="{Binding OrtalamaVade, StringFormat='{}{0} G'}" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                                                 </Border>
                                                             </StackPanel>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>

                             <TabItem Header="Borç Takibi">
                                 <ScrollViewer Margin="0,12,0,0">
                                     <ItemsControl ItemsSource="{Binding PayableCaris}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="#07090E" CornerRadius="14" Padding="14,12" Margin="0,0,10,8" BorderBrush="#F43F5E" BorderThickness="1,1,1,3">
                                                     <Grid ColumnDefinitions="*, Auto">
                                                         <StackPanel>
                                                             <TextBlock Text="{Binding Unvan}" Foreground="White" FontWeight="Bold" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                                 <TextBlock Text="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Foreground="#F43F5E" FontSize="17" FontWeight="Black"/>
                                                                 <Border Background="#25F43F5E" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                     <TextBlock Text="{Binding OrtalamaVade, StringFormat='{}{0} G'}" Foreground="#F43F5E" FontSize="10" FontWeight="Bold"/>
                                                                 </Border>
                                                             </StackPanel>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>
                         </TabControl>
                     </Border>
                 </Grid>
             </Grid>
         </Border>
     </Grid>

     <!-- =========================================================================
          2. CUPERTINO FROSTED GLASS: Apple macOS Gerçek Akrilik Buzlu Cam
          ========================================================================= -->
     <Grid IsVisible="{Binding IsCupertinoGlass}">
         <Border Padding="28">
             <Grid RowDefinitions="Auto, Auto, *" RowSpacing="20">
                 
                 <!-- 1. Apple macOS Quick Actions (Frosted Glass Acrylic Pills) -->
                 <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,-14,0">
                      <!-- Alış (Apple Coral Red) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Alis" Height="74" Margin="0,0,14,0" HorizontalAlignment="Stretch" CornerRadius="20" BorderBrush="#45FF453A" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#802D1520" Offset="0"/>
                                  <GradientStop Color="#551E1428" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="16" Background="#35FF453A">
                                  <ic:SymbolIcon Symbol="Cart" Foreground="#FF453A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Alış" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Fatura Girişi" FontSize="11" Foreground="#94A3B8"/>
                              </StackPanel>
                          </Grid>
                      </Button>
 
                      <!-- Satış (Apple System Blue & Sky Acrylic) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Satis" Height="74" Margin="0,0,14,0" HorizontalAlignment="Stretch" CornerRadius="20" BorderBrush="#6038BDF8" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#CC0A84FF" Offset="0"/>
                                  <GradientStop Color="#AA38BDF8" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="16" Background="#35FFFFFF">
                                  <ic:SymbolIcon Symbol="Tag" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Satış" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Hızlı Satış" FontSize="11" Foreground="White" Opacity="0.95"/>
                              </StackPanel>
                          </Grid>
                      </Button>
                      
                      <!-- Sipariş (Apple Amber / Orange) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Siparis" Height="74" Margin="0,0,14,0" HorizontalAlignment="Stretch" CornerRadius="20" BorderBrush="#45FF9F0A" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#802C2014" Offset="0"/>
                                  <GradientStop Color="#551C1A24" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="16" Background="#35FF9F0A">
                                  <ic:SymbolIcon Symbol="ClipboardText" Foreground="#FF9F0A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Sipariş" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Sipariş Yaz" FontSize="11" Foreground="#94A3B8"/>
                              </StackPanel>
                          </Grid>
                      </Button>
 
                      <!-- Teklif (Apple Mint / Emerald) -->
                      <Button Command="{Binding QuickActionCommand}" CommandParameter="Teklif" Height="74" Margin="0,0,14,0" HorizontalAlignment="Stretch" CornerRadius="20" BorderBrush="#4530D158" BorderThickness="1.5">
                          <Button.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                  <GradientStop Color="#80152B1E" Offset="0"/>
                                  <GradientStop Color="#5512211C" Offset="1"/>
                              </LinearGradientBrush>
                          </Button.Background>
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="46" Height="46" CornerRadius="16" Background="#3530D158">
                                  <ic:SymbolIcon Symbol="DocumentPercent" Foreground="#30D158" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="Teklif" FontSize="16" FontWeight="Black" Foreground="White"/>
                                  <TextBlock Text="Teklif Hazırla" FontSize="11" Foreground="#94A3B8"/>
                              </StackPanel>
                          </Grid>
                      </Button>
                 </UniformGrid>

                 <!-- 2. Apple macOS Frosted Acrylic Glass KPI Cards -->
                 <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-14,0">
                     <!-- Günlük Ciro (Frosted Glass Card) -->
                     <Border Background="#731E293B" BorderBrush="#5038BDF8" BorderThickness="1.5" CornerRadius="22" Padding="20,15" Margin="0,0,14,0" Height="88" BoxShadow="0 10 32 0 #35000000, 0 1 1 0 #25FFFFFF">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="#30FACC15">
                                  <ic:SymbolIcon Symbol="Wallet" Foreground="#FACC15" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding GunlukSatis, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="#F8FAFC"/>
                                  <TextBlock Text="Günlük Ciro" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                              </StackPanel>
                          </Grid>
                     </Border>
                     
                     <!-- Toplam Alacak (Frosted Glass Card) -->
                     <Border Background="#731E293B" BorderBrush="#5038BDF8" BorderThickness="1.5" CornerRadius="22" Padding="20,15" Margin="0,0,14,0" Height="88" BoxShadow="0 10 32 0 #35000000, 0 1 1 0 #25FFFFFF">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="#300A84FF">
                                  <ic:SymbolIcon Symbol="ArrowTrendingLines" Foreground="#38BDF8" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding ToplamAlacak, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="#F8FAFC"/>
                                  <TextBlock Text="Toplam Alacak" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                              </StackPanel>
                          </Grid>
                     </Border>
  
                     <!-- Toplam Borç (Frosted Glass Card) -->
                     <Border Background="#731E293B" BorderBrush="#5038BDF8" BorderThickness="1.5" CornerRadius="22" Padding="20,15" Margin="0,0,14,0" Height="88" BoxShadow="0 10 32 0 #35000000, 0 1 1 0 #25FFFFFF">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="#30FF453A">
                                  <ic:SymbolIcon Symbol="Warning" Foreground="#FF453A" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding ToplamBorc, StringFormat='{}{0:N2} ₺'}" FontSize="22" FontWeight="Black" Foreground="#F8FAFC"/>
                                  <TextBlock Text="Toplam Borç" FontSize="12" Foreground="#FF453A" FontWeight="SemiBold"/>
                              </StackPanel>
                          </Grid>
                     </Border>

                     <!-- Net Bakiye Durumu (Frosted Glass Card) -->
                     <Border Background="#731E293B" BorderBrush="{Binding NetColorBrush}" BorderThickness="1.5" CornerRadius="22" Padding="20,15" Margin="0,0,14,0" Height="88" BoxShadow="0 10 32 0 #35000000, 0 1 1 0 #25FFFFFF">
                          <Grid ColumnDefinitions="Auto, *">
                              <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="{Binding NetBgBrush}">
                                  <ic:SymbolIcon Symbol="Money" Foreground="{Binding NetColorBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                  <TextBlock Text="{Binding NetBakiyeText}" FontSize="22" FontWeight="Black" Foreground="{Binding NetColorBrush}"/>
                                  <TextBlock Text="Net Finansal Durum" FontSize="12" Foreground="{Binding NetColorBrush}" FontWeight="SemiBold"/>
                              </StackPanel>
                          </Grid>
                     </Border>
                 </UniformGrid>
                
                 <!-- 3. Lower Section: Frosted Acrylic Glass Chart & Tabs -->
                 <Grid Grid.Row="2" ColumnDefinitions="6*, 4*">
                     <!-- Chart Section -->
                     <Border Grid.Column="0" Background="#731E293B" BorderBrush="#4538BDF8" BorderThickness="1.5" CornerRadius="24" Padding="25" Margin="0,0,20,0" BoxShadow="0 12 40 0 #35000000, 0 1 1 0 #25FFFFFF">
                         <Grid RowDefinitions="Auto, *">
                             <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,22">
                                 <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                     <Border Background="#300A84FF" Width="42" Height="42" CornerRadius="14">
                                         <ic:SymbolIcon Symbol="Target" Foreground="#38BDF8" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                     <TextBlock Text="Hedef &amp; Gerçekleşme" FontSize="20" FontWeight="Black" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                 </StackPanel>
                                 
                                 <Border Grid.Column="1" Background="#4D0F172A" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="16" Padding="4" HorizontalAlignment="Right">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                         <Button Command="{Binding ToggleGoalPeriodCommand}" CommandParameter="Weekly"
                                                 Background="{Binding IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Background}" 
                                                 BorderThickness="0" CornerRadius="12" Width="84" Height="36">
                                             <TextBlock Text="Hafta" FontSize="13" Foreground="{Binding IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                         </Button>
                                         <Button Command="{Binding ToggleGoalPeriodCommand}" CommandParameter="Monthly"
                                                 Background="{Binding !IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Background}"
                                                 BorderThickness="0" CornerRadius="12" Width="84" Height="36">
                                             <TextBlock Text="Ay" FontSize="13" Foreground="{Binding !IsWeeklyGoal, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                         </Button>
                                     </StackPanel>
                                 </Border>
                             </Grid>
                             <lvc:CartesianChart Grid.Row="1" Series="{Binding TargetVsActualSeries}" XAxes="{Binding TargetVsActualXAxis}" YAxes="{Binding TargetVsActualYAxis}"/>
                         </Grid>
                     </Border>

                     <!-- Tabs Section (Frosted Acrylic Glass) -->
                     <Border Grid.Column="1" Background="#731E293B" BorderBrush="#4538BDF8" BorderThickness="1.5" CornerRadius="24" Padding="14" BoxShadow="0 12 40 0 #35000000, 0 1 1 0 #25FFFFFF">
                         <TabControl>
                             <TabControl.Styles>
                                 <Style Selector="TabItem">
                                     <Setter Property="FontSize" Value="14"/>
                                     <Setter Property="FontWeight" Value="SemiBold"/>
                                     <Setter Property="Padding" Value="14,10"/>
                                 </Style>
                             </TabControl.Styles>
                             
                             <TabItem Header="Son İşlemler">
                                 <ScrollViewer Margin="0,12,0,0">
                                     <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="#550F172A" CornerRadius="16" Padding="15,12" Margin="0,0,10,10" BorderBrush="#25FFFFFF" BorderThickness="1">
                                                     <Grid ColumnDefinitions="*, Auto">
                                                         <StackPanel Grid.Column="0" Spacing="3">
                                                             <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"/>
                                                             <TextBlock Text="{Binding Description}" Foreground="#94A3B8" FontSize="11"/>
                                                         </StackPanel>
                                                         <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                             <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} ₺'}" Foreground="{Binding TextColor, FallbackValue='#38BDF8'}" FontWeight="Black" FontSize="17" HorizontalAlignment="Right"/>
                                                             <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM HH:mm}'}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right"/>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>

                             <TabItem Header="Alacak Takibi">
                                 <ScrollViewer Margin="0,12,0,0">
                                     <ItemsControl ItemsSource="{Binding RiskyCaris}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="#550F172A" CornerRadius="16" Padding="15,12" Margin="0,0,10,10" BorderBrush="#38BDF8" BorderThickness="1,1,1,3">
                                                     <Grid>
                                                         <StackPanel>
                                                             <TextBlock Text="{Binding Unvan}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                                 <TextBlock Text="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Foreground="#38BDF8" FontSize="17" FontWeight="Black"/>
                                                                 <Border Background="#3038BDF8" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                     <TextBlock Text="{Binding OrtalamaVade, StringFormat='{}{0} G'}" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold"/>
                                                                 </Border>
                                                             </StackPanel>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>

                             <TabItem Header="Borç Takibi">
                                 <ScrollViewer Margin="0,12,0,0">
                                     <ItemsControl ItemsSource="{Binding PayableCaris}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                 <Border Background="#550F172A" CornerRadius="16" Padding="15,12" Margin="0,0,10,10" BorderBrush="#FF453A" BorderThickness="1,1,1,3">
                                                     <Grid ColumnDefinitions="*, Auto">
                                                         <StackPanel>
                                                             <TextBlock Text="{Binding Unvan}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                                 <TextBlock Text="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Foreground="#FF453A" FontSize="17" FontWeight="Black"/>
                                                                 <Border Background="#30FF453A" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                     <TextBlock Text="{Binding OrtalamaVade, StringFormat='{}{0} G'}" Foreground="#FF453A" FontSize="10" FontWeight="SemiBold"/>
                                                                 </Border>
                                                             </StackPanel>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </ScrollViewer>
                             </TabItem>
                         </TabControl>
                     </Border>
                 </Grid>
             </Grid>
         </Border>
     </Grid>

    <!-- ENTERPRISE: Dense, Excel-like -->
    <Grid IsVisible="{Binding IsEnterprise}" RowDefinitions="Auto, Auto, Auto, *" Background="#E6E6E6">
      <!-- Ribbon Toolbar -->
      <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="8,6">
        <Grid ColumnDefinitions="Auto, *, Auto">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Content="File" Padding="12,6" Background="Transparent" CornerRadius="0"/>
            <Button Content="Home" Padding="12,6" Background="#107C41" Foreground="White" CornerRadius="0"/>
            <Button Content="Insert" Padding="12,6" Background="Transparent" CornerRadius="0"/>
            <Button Content="View" Padding="12,6" Background="Transparent" CornerRadius="0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Command Bar -->
      <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="8,4">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Padding="8,4" Background="Transparent" BorderThickness="1" BorderBrush="#9CA3AF" CornerRadius="0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16"/> 
              <TextBlock Text="Refresh" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Padding="8,4" Background="Transparent" BorderThickness="1" BorderBrush="#9CA3AF" CornerRadius="0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="ArrowExport" FontSize="16"/> 
              <TextBlock Text="Export" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Padding="8,4" Background="Transparent" BorderThickness="1" BorderBrush="#9CA3AF" CornerRadius="0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="Print" FontSize="16"/> 
              <TextBlock Text="Print" FontSize="12"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Status Bar -->
      <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Background="White">
        <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,4">
          <StackPanel>
            <TextBlock Text="Günlük Satış" FontSize="10" Foreground="#6B7280"/>
            <TextBlock Text="{Binding GunlukSatis, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#000000"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,4">
          <StackPanel>
            <TextBlock Text="Tahsilat" FontSize="10" Foreground="#6B7280"/>
            <TextBlock Text="{Binding ToplamTahsilat, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#107C41"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8,4">
          <StackPanel>
            <TextBlock Text="Bekleyen" FontSize="10" Foreground="#6B7280"/>
            <TextBlock Text="{Binding BekleyenOdeme, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Padding="8,4">
          <StackPanel>
            <TextBlock Text="Stok" FontSize="10" Foreground="#6B7280"/>
            <TextBlock Text="{Binding StokSayisi}" FontSize="14" FontWeight="Bold" Foreground="#000000"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Content Area -->
      <Grid Grid.Row="3" ColumnDefinitions="2*, 1*" Margin="2">
        <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,1,0">
          <Grid RowDefinitions="Auto, *">
            <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Satış Trendi (Aylık)" FontSize="12" FontWeight="SemiBold" Foreground="#000000"/>
            </Border>
            <lvc:CartesianChart Grid.Row="1" Series="{Binding SatisGrafigiSeries}" XAxes="{Binding XAxis}" Margin="4"/>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="1,0,0,0">
          <Grid RowDefinitions="Auto, *">
            <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,4">
              <TextBlock Text="Gelir Dağılımı" FontSize="12" FontWeight="SemiBold" Foreground="#000000"/>
            </Border>
            <lvc:PieChart Grid.Row="1" Series="{Binding GelirDaigilimSeries}" LegendPosition="Bottom" Margin="4"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- WINDOWS FLUENT: Dark Mica-style -->
    <ScrollViewer IsVisible="{Binding IsWindowsFluent}">
      <Grid RowDefinitions="Auto, Auto, *" Margin="16">
        <!-- Acrylic Header (Glassy Dark) -->
        <Border Grid.Row="0" Background="#20FFFFFF" CornerRadius="8" Padding="20,16" Margin="0,0,0,16" BoxShadow="0 4 10 0 #000000">
          <Grid ColumnDefinitions="Auto, *, Auto">
            <Border Width="48" Height="48" CornerRadius="24" Background="#30FFFFFF" Margin="0,0,16,0">
              <ic:SymbolIcon Symbol="Home" FontSize="24" Foreground="#60CDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Horizon Accounting - Dashboard" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Overview of your business" FontSize="13" Foreground="#CCCCCC" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Exchange" Background="#60CDFF" Foreground="Black" Padding="16,8" CornerRadius="4"/>
          </Grid>
        </Border>

        <!-- Gradient Cards (Neon/Dark) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 12, *" Margin="0,0,0,16">
          <!-- Total Revenue Card -->
          <Border Grid.Column="0" CornerRadius="12" Height="160" BoxShadow="0 0 20 0 #1060CDFF" Padding="24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#101020" Offset="0"/>
                <GradientStop Color="#003060" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Günlük Ciro" FontSize="16" Foreground="#60CDFF" FontWeight="Medium"/>
              <TextBlock Text="{Binding GunlukSatis, StringFormat='{}{0:N2} ₺'}" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
 
          <!-- Cash Flow Card -->
          <Border Grid.Column="2" CornerRadius="12" Height="160" BoxShadow="0 0 20 0 #107C3AED" Padding="24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#151020" Offset="0"/>
                <GradientStop Color="#301040" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Aylık Toplam" FontSize="16" Foreground="#B084FF" FontWeight="Medium"/>
              <TextBlock Text="{Binding ToplamTahsilat, StringFormat='{}{0:N2} ₺'}" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,12,0,0"/>
              <TextBlock Text="Son 30 günün özeti" FontSize="14" Foreground="#B084FF" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Content Cards (Glassy Dark) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 12, *" Height="400">
          <!-- Recent Transactions -->
          <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="12" Padding="20" BoxShadow="0 4 10 0 #000000">
            <Grid RowDefinitions="Auto, *">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Gelir Dağılımı (Kategori)" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                <Button Grid.Column="1" Content="Hepsini Gör" Background="Transparent" Foreground="#60CDFF" Padding="8,4"/>
              </Grid>

              <lvc:PieChart Grid.Row="1" Series="{Binding GelirDaigilimSeries}" Margin="0,16,0,0"/>
            </Grid>
          </Border>

          <!-- Cash Flow Chart -->
          <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="12" Padding="20" BoxShadow="0 4 10 0 #000000">
            <Grid RowDefinitions="Auto, *">
              <TextBlock Text="Satış Trendi (Son 6 Ay)" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
              <lvc:CartesianChart Grid.Row="1" Series="{Binding SatisGrafigiSeries}" Margin="0,16,0,0"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>

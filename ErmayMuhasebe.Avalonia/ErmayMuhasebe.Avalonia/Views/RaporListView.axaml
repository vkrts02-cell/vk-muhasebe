<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:conv="using:ErmayMuhasebe.Avalonia.Converters"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="1000"
             x:Class="ErmayMuhasebe.Avalonia.Views.RaporListView"
             x:DataType="vm:RaporListViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Resources>
      <conv:SymbolIconConverter x:Key="SymbolIconConverter"/>
      <conv:CariTurToTextConverter x:Key="CariTurToTextConverter"/>
      <conv:CariTurToBrushConverter x:Key="CariTurToBrushConverter"/>
  </UserControl.Resources>

  <UserControl.Styles>
      <!-- Standardized TextBox Overrides -->
      <Style Selector="TextBox.SearchInput">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="12"/>
      </Style>
      <Style Selector="TextBox.SearchInput /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
      </Style>
      <Style Selector="TextBox.SearchInput:pointerover /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
      </Style>
      <Style Selector="TextBox.SearchInput:focus /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
      </Style>

      <Style Selector="Button.DateFilterBtn">
          <Setter Property="Background" Value="#1A2230"/>
          <Setter Property="Foreground" Value="#CBD5E1"/>
          <Setter Property="BorderBrush" Value="#2A384C"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Padding" Value="14,8"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Cursor" Value="Hand"/>
      </Style>
      <Style Selector="Button.DateFilterBtn:pointerover">
          <Setter Property="Background" Value="#2563EB"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="#3B82F6"/>
      </Style>
  </UserControl.Styles>

  <Panel>
    <Grid RowDefinitions="Auto, *" Margin="40">
      <!-- Header & Date Filter Bar -->
      <Grid Grid.Row="0" Margin="0,0,0,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header: Title and Search Box -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="Raporlar Merkezi" FontSize="18" FontWeight="Bold">
               <TextBlock.Foreground>
                  <SolidColorBrush Color="#3B82F6"/>
               </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="İşletme analizlerinizi tek noktadan profesyonelce yönetin." 
                       FontSize="16" Foreground="#85FFFFFF" FontWeight="Medium"/>
          </StackPanel>

          <!-- Advanced Search Box with Precision Centering -->
          <Border Grid.Column="1" Background="#080A0C" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1.5" Height="48" VerticalAlignment="Center">
             <Grid ColumnDefinitions="48, *">
                <ic:SymbolIcon Grid.Column="0" Symbol="Search" Foreground="#60A5FA" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Width="300" Watermark="Rapor adı ara..." 
                         Classes="SearchInput"
                         Text="{Binding SearchString}" 
                         VerticalContentAlignment="Center" 
                         FontSize="15" Padding="0,0,20,0"
                         VerticalAlignment="Center">
                   <TextBox.KeyBindings>
                      <KeyBinding Command="{Binding SearchReportsCommand}" Gesture="Enter"/>
                   </TextBox.KeyBindings>
                </TextBox>
             </Grid>
          </Border>
        </Grid>

        <!-- Date Filter Toolbar -->
        <Border Grid.Row="1" Margin="0,20,0,0" Background="#111622" CornerRadius="14" BorderBrush="#26334D" BorderThickness="1" Padding="14,10">
           <Grid ColumnDefinitions="Auto, *, Auto">
              <!-- Left: Quick Date Filters -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                 <Border Background="#1E293B" CornerRadius="8" Padding="10,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                       <ic:SymbolIcon Symbol="Calendar" FontSize="16" Foreground="#60A5FA"/>
                       <TextBlock Text="Dönem:" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                 </Border>

                 <Button Content="Tümü" Classes="DateFilterBtn"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="All"
                         ToolTip.Tip="Tüm zamanların verilerini listele"/>
                 <Button Content="Haftalık" Classes="DateFilterBtn"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="Weekly"
                         ToolTip.Tip="Bu haftanın verilerini listele"/>
                 <Button Content="Aylık" Classes="DateFilterBtn"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="Monthly"
                         ToolTip.Tip="Bu ayın verilerini listele"/>
                 <Button Content="Yıllık" Classes="DateFilterBtn"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="Yearly"
                         ToolTip.Tip="Bu yılın verilerini listele"/>
                 <Button Classes="DateFilterBtn"
                         Command="{Binding OpenDateSelectionCommand}"
                         ToolTip.Tip="Özel başlangıç ve bitiş tarihi belirle">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                       <ic:SymbolIcon Symbol="Calendar" FontSize="15" Foreground="#38BDF8"/>
                       <TextBlock Text="Özel Tarih..." VerticalAlignment="Center"/>
                    </StackPanel>
                 </Button>
              </StackPanel>

              <!-- Right: Active Date Range Display -->
              <Border Grid.Column="2" Background="#182234" CornerRadius="8" Padding="12,6" BorderBrush="#3B82F6" BorderThickness="1" VerticalAlignment="Center">
                 <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="CalendarClock" FontSize="16" Foreground="#38BDF8"/>
                    <TextBlock Text="Seçili Aralık:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DateRangeText}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                 </StackPanel>
              </Border>
           </Grid>
        </Border>
      </Grid>

      <!-- Reports Grid: Responsive Wrap Layout -->
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl ItemsSource="{Binding Reports}">
            <ItemsControl.ItemsPanel>
               <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
               </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
               <DataTemplate>
                  <Border Width="310" Height="240" Margin="0,0,25,25" 
                          Background="{DynamicResource PanelBrush}" 
                          BorderBrush="{DynamicResource BorderColor}" 
                          BorderThickness="1" 
                          CornerRadius="20" 
                          Padding="24">
                     <Border.Styles>
                        <Style Selector="Border:pointerover">
                           <Setter Property="Background" Value="#252A32"/>
                           <Setter Property="BorderBrush" Value="#8060A5FA"/>
                           <Setter Property="BoxShadow" Value="0 10 30 0 #40000000"/>
                        </Style>
                     </Border.Styles>

                     <Grid RowDefinitions="Auto, *, Auto">
                        <!-- Title Section -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                           <Border Grid.Column="0" Width="48" Height="48" 
                                   Background="#1560A5FA" CornerRadius="12" 
                                   Margin="0,0,15,0" VerticalAlignment="Center">
                              <ic:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource SymbolIconConverter}}" 
                                             FontSize="22" Foreground="#60A5FA"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                           </Border>
                           <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                      FontWeight="Black" VerticalAlignment="Center" 
                                      FontSize="16" Foreground="White" 
                                      TextWrapping="Wrap" MaxLines="2"/>
                        </Grid>
                        
                        <!-- Description Section -->
                        <TextBlock Grid.Row="1" Text="{Binding Description}" 
                                   FontSize="13" Foreground="#85FFFFFF" 
                                   TextWrapping="Wrap" Margin="0,15,0,20" MaxLines="3" LineHeight="19"/>
                        
                        <!-- Footer Section -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Bottom" Height="45">
                           <!-- Category Badge -->
                           <Border Grid.Column="0" Background="#1560A5FA" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                               <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#60A5FA" FontWeight="Bold" Margin="0,0.5,0,0"/>
                           </Border>
                           
                           <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                               <Button Command="{Binding $parent[ItemsControl].DataContext.RunReportCommand}" 
                                       CommandParameter="{Binding}"
                                       Classes="Info" Width="50" Height="42" CornerRadius="21"
                                       ToolTip.Tip="Raporu Görüntüle">
                                  <ic:SymbolIcon Symbol="Open" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                               </Button>

                               <Button Command="{Binding $parent[ItemsControl].DataContext.PrintReportCommand}" 
                                       CommandParameter="{Binding}"
                                       Classes="Warning" Width="90" Height="42" CornerRadius="21">
                                    <Grid ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center">
                                       <ic:SymbolIcon Symbol="Print" FontSize="18" Foreground="White" VerticalAlignment="Center"/> 
                                       <TextBlock Grid.Column="1" Text="YAZDIR" FontSize="10" FontWeight="Black" 
                                                  Foreground="White" VerticalAlignment="Center" Margin="8,1,0,0"/>
                                    </Grid>
                               </Button>
                            </StackPanel>
                        </Grid>
                     </Grid>
                  </Border>
               </DataTemplate>
            </ItemsControl.ItemTemplate>
         </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- CARI SELECTION OVERLAY -->
    <Border IsVisible="{Binding IsCariSelectionVisible}" Background="#CC000000" ZIndex="100">
       <Border Background="{DynamicResource PanelBrush}" Width="600" Height="500" CornerRadius="20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
          <Grid RowDefinitions="Auto, Auto, *">
             <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <TextBlock Text="Cari Hesap Seçiniz" FontSize="20" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding CloseCariSelectionCommand}" Classes="Danger" Width="32" Height="32" Padding="0" CornerRadius="16">
                   <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                </Button>
             </Grid>

             <Border Grid.Row="1" Background="#15FFFFFF" CornerRadius="12" Margin="0,0,0,20" Height="50">
                <TextBox Watermark="Ünvan veya kod ile ara..." 
                         Text="{Binding CariSearchTerm}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="15" Padding="15,0">
                   <TextBox.KeyBindings>
                      <KeyBinding Command="{Binding SearchCariCommand}" Gesture="Enter"/>
                   </TextBox.KeyBindings>
                </TextBox>
             </Border>

             <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding CariSearchResults}">
                   <ItemsControl.ItemTemplate>
                      <DataTemplate>
                         <Button Command="{Binding $parent[UserControl].DataContext.SelectCariCommand}" 
                                 CommandParameter="{Binding}" 
                                 Background="Transparent" 
                                 Padding="0" 
                                 HorizontalAlignment="Stretch" 
                                 HorizontalContentAlignment="Stretch"
                                 Margin="0,0,0,2">
                            <Border Background="#0DFFFFFF" CornerRadius="6" Padding="12,4" BorderBrush="#05FFFFFF" BorderThickness="1">
                               <Border.Styles>
                                  <Style Selector="Border:pointerover">
                                     <Setter Property="Background" Value="#253040"/>
                                     <Setter Property="BorderBrush" Value="#4060A5FA"/>
                                  </Style>
                               </Border.Styles>
                               <Grid ColumnDefinitions="Auto, *, Auto">
                                  <!-- Type Indicator Color Bar -->
                                  <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5" Margin="0,0,10,0"
                                          Background="{Binding Tur, Converter={StaticResource CariTurToBrushConverter}}"/>
                                  
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                     <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Unvan}" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                        <Border Background="{Binding Tur, Converter={StaticResource CariTurToBrushConverter}}" Opacity="0.15" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                           <TextBlock Text="{Binding Tur, Converter={StaticResource CariTurToTextConverter}}" FontSize="7" FontWeight="Black" Foreground="{Binding Tur, Converter={StaticResource CariTurToBrushConverter}}"/>
                                        </Border>
                                     </StackPanel>
                                     <TextBlock Text="{Binding CariKod}" FontSize="9" Foreground="#44FFFFFF" Margin="0,0,0,0"/>
                                  </StackPanel>
                                  
                                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                     <TextBlock Text="{Binding Bakiye, StringFormat={}{0:C2}}" FontWeight="Black" FontSize="12" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                     <TextBlock Text="Bakiye" FontSize="7" Foreground="#30FFFFFF" HorizontalAlignment="Right" Margin="0,-1,0,0"/>
                                  </StackPanel>
                               </Grid>
                            </Border>
                         </Button>
                      </DataTemplate>
                   </ItemsControl.ItemTemplate>
                </ItemsControl>
             </ScrollViewer>
          </Grid>
       </Border>
     </Border>

    <!-- DATE SELECTION OVERLAY -->
    <Border IsVisible="{Binding IsDateSelectionVisible}" Background="#CC000000" ZIndex="100">
       <Border Background="{DynamicResource PanelBrush}" Width="450" CornerRadius="20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
          <StackPanel Spacing="20">
             <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Tarih Aralığı Seçiniz" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding CloseDateSelectionCommand}" Classes="Danger" Width="32" Height="32" Padding="0" CornerRadius="16">
                   <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                </Button>
             </Grid>

             <!-- Quick Period Selectors inside overlay -->
             <Grid ColumnDefinitions="*, *, *, *">
                 <Button Grid.Column="0" Content="Haftalık" Classes="DateFilterBtn" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="Weekly"/>
                 <Button Grid.Column="1" Content="Aylık" Classes="DateFilterBtn" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="Monthly"/>
                 <Button Grid.Column="2" Content="Yıllık" Classes="DateFilterBtn" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="Yearly"/>
                 <Button Grid.Column="3" Content="Tümü" Classes="DateFilterBtn" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                         Command="{Binding SetDateFilterCommand}" CommandParameter="All"/>
             </Grid>

             <StackPanel Spacing="15">
                 <StackPanel Spacing="5">
                     <TextBlock Text="Başlangıç Tarihi" FontSize="12" Foreground="#94A3B8"/>
                     <CalendarDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" CustomDateFormatString="dd.MM.yyyy" SelectedDateFormat="Custom" HorizontalAlignment="Stretch" Background="#10FFFFFF" BorderBrush="#20FFFFFF"/>
                 </StackPanel>
                 <StackPanel Spacing="5">
                     <TextBlock Text="Bitiş Tarihi" FontSize="12" Foreground="#94A3B8"/>
                     <CalendarDatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" CustomDateFormatString="dd.MM.yyyy" SelectedDateFormat="Custom" HorizontalAlignment="Stretch" Background="#10FFFFFF" BorderBrush="#20FFFFFF"/>
                 </StackPanel>
             </StackPanel>

             <Button Command="{Binding SelectDateRangeCommand}" Classes="Success" HorizontalAlignment="Stretch" Height="40" CornerRadius="10">
                 <TextBlock Text="RAPORU HAZIRLA" FontSize="12" FontWeight="Heavy" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Button>
          </StackPanel>
       </Border>
    </Border>

    <!-- LOADING OVERLAY -->
    <Border IsVisible="{Binding IsGenerating}" Background="#AA000000" ZIndex="200">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#60A5FA"/>
            <TextBlock Text="Rapor Paketi Hazırlanıyor..." 
                       HorizontalAlignment="Center" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="White"/>
            <TextBlock Text="Lütfen bekleyiniz, veriler analiz ediliyor." 
                       HorizontalAlignment="Center" 
                       FontSize="13" 
                       Foreground="#80FFFFFF"/>
        </StackPanel>
    </Border>

    <!-- ERROR OVERLAY -->
    <Border IsVisible="{Binding IsErrorVisible}" Background="#CC330000" ZIndex="210">
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="#FF5555" BorderThickness="1" CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
             <StackPanel Spacing="20">
                <ic:SymbolIcon Symbol="ErrorCircle" FontSize="48" Foreground="#FF5555" HorizontalAlignment="Center"/>
                <TextBlock Text="Hata Oluştu" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding ErrorMessage}" 
                           HorizontalAlignment="Center" 
                           FontSize="16" 
                           Foreground="#DDDDDD"
                           TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
                <Button Content="Kapat" 
                        Command="{Binding ClearErrorCommand}" 
                        Background="#FF5555" Foreground="White"
                        HorizontalAlignment="Center" Width="120" Height="40" CornerRadius="20"/>
             </StackPanel>
        </Border>
    </Border>
  </Panel>
</UserControl>

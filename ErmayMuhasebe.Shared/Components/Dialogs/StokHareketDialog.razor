@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@inject DatabaseService DbService
@inject ISnackbar Snackbar

<style>
    .glass-dialog {
        background: rgba(30, 34, 40, 0.6) !important;
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 24px !important;
        color: white !important;
    }

    .glass-input-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px;
    }

    .dialog-header-label {
        font-size: 11px;
        font-weight: 900;
        color: rgba(255,255,255,0.4);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .dialog-action-btn {
        border-radius: 14px !important;
        font-weight: 800 !important;
        padding: 12px 24px !important;
        text-transform: none !important;
    }

    .product-info-pill {
        background: rgba(96, 165, 250, 0.1);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }
</style>

<MudDialog Class="glass-dialog">
    <DialogContent>
        <div class="pa-4" style="min-width: 450px;">
            @* PRODUCT SUMMARY *@
            <div class="product-info-pill d-flex align-center gap-4">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(96,165,250,0.2); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Info" Size="Size.Small" />
                </div>
                <div>
                    <MudText Style="font-size: 14px; font-weight: 900; color: white;">@Stok?.StokAdi</MudText>
                    <MudText Style="font-size: 11px; color: rgba(255,255,255,0.5);">Kodu: @Stok?.StokKodu | Güncel: @Stok?.Miktar.ToString("N1") @Stok?.Birim</MudText>
                </div>
            </div>

            <div class="glass-input-box">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <div class="dialog-header-label">İŞLEM TÜRÜ VE TARİH</div>
                        <div class="d-flex gap-3">
                             <div class="flex-grow-1">
                                <MudTextField @bind-Value="islemTuru" Variant="Variant.Outlined" ReadOnly="true" 
                                              Margin="Margin.Dense" Class="bg-dark-input" 
                                              Style="@($"color: {(IslemTuru == "GİRİŞ" ? "#34D399" : "#F87171")}; font-weight: 900;")" />
                             </div>
                             <div class="flex-grow-1">
                                <MudDatePicker @bind-Date="tarih" Variant="Variant.Outlined" Margin="Margin.Dense" Class="bg-dark-input" Color="Color.Info" />
                             </div>
                        </div>
                    </MudItem>
                    
                    <MudItem xs="12">
                         <div class="dialog-header-label">HAREKET MİKTARI</div>
                         <MudNumericField @bind-Value="miktar" Variant="Variant.Outlined" 
                                          Adornment="Adornment.End" AdornmentText="@Stok?.Birim"
                                          Class="bg-dark-input" Margin="Margin.Dense" AutoFocus="true" HideSpinButtons="true"
                                          Style="font-size: 20px; font-weight: 900; color: #60A5FA;" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <div class="dialog-header-label">AÇIKLAMA</div>
                        <MudTextField @bind-Value="aciklama" Variant="Variant.Outlined" Lines="2" 
                                      Placeholder="İşlem ile ilgili notlar..."
                                      Class="bg-dark-input" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="dialog-action-btn" Color="Color.Default">Vazgeç</MudButton>
        <MudButton OnClick="Submit" Class="dialog-action-btn" 
                   Variant="Variant.Filled" 
                   Color="@(IslemTuru == "GİRİŞ" ? Color.Success : Color.Error)" 
                   StartIcon="@(IslemTuru == "GİRİŞ" ? Icons.Material.Filled.Add : Icons.Material.Filled.Remove)">
            HAREKETİ KAYDET
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public StokKart Stok { get; set; } = null!;
    [Parameter] public string IslemTuru { get; set; } = "GİRİŞ";
    
    private string islemTuru = "GİRİŞ";
    private DateTime? tarih = DateTime.Now;
    private decimal miktar = 0;
    private string aciklama = "";
    
    protected override void OnInitialized()
    {
        islemTuru = IslemTuru;
        if (string.IsNullOrEmpty(aciklama))
        {
            aciklama = IslemTuru == "GİRİŞ" ? "MANUEL ENVANTER GİRİŞİ" : "MANUEL ENVANTER ÇIKIŞI";
        }
    }
    
    void Cancel() => MudDialog.Cancel();
    
    async Task Submit()
    {
        if (Stok == null) return;
        
        if (miktar <= 0)
        {
            Snackbar.Add("Geçersiz miktar!", Severity.Warning);
            return;
        }
        
        // Update Stock Amount
        if (IslemTuru == "GİRİŞ")
        {
            Stok.Miktar += miktar;
        }
        else if (IslemTuru == "ÇIKIŞ")
        {
            if (Stok.Miktar < miktar)
            {
                Snackbar.Add("Hata: Yetersiz stok mevcudu!", Severity.Error);
                return;
            }
            Stok.Miktar -= miktar;
        }
        
        await DbService.SaveStokAsync(Stok);
        
        // Create Record
        var hareket = new StokHareket
        {
            StokId = Stok.Id,
            StokKodu = Stok.StokKodu,
            StokAdi = Stok.StokAdi,
            Tarih = tarih ?? DateTime.Now,
            IslemTuru = IslemTuru,
            Miktar = (decimal)miktar,
            Aciklama = aciklama,
            EvrakNo = "M-" + DateTime.Now.ToString("mmss"),
            EvrakTuru = "MANUEL - " + IslemTuru
        };
        
        await DbService.SaveStokHareketAsync(hareket);
        
        Snackbar.Add($"Stok {IslemTuru.ToLower()} kaydı oluşturuldu.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}

@page "/stok-devir"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@inject DatabaseService DbService
@inject NavigationManager Nav
@inject IPdfService PdfService
@inject IFileService FileService
@inject ISnackbar Snackbar
@using MudBlazor

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5" Color="MudBlazor.Color.Primary">Stok Devir Hızı Raporu</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.List" OnClick="@(() => Nav.NavigateTo("/raporlar-menu"))">Tüm Raporlar</MudButton>
        @if(analizListesi != null && analizListesi.Any())
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintReport">
                Yazdır / PDF
            </MudButton>
        }
    </MudStack>
</div>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.body2" Class="mb-2">Stokların devir hızı analizi. (Basitleştirilmiş hesaplama: Satış Miktarı / Ortalama Stok)</MudText>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="LoadData">
            Analiz Yap
        </MudButton>
    </div>
    </MudPaper>

    @if(analizListesi != null && analizListesi.Any())
    {
        <MudTable Items="@analizListesi" Hover="true" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh>Stok Adı</MudTh>
                <MudTh Style="text-align:right">Satış Miktarı</MudTh>
                <MudTh Style="text-align:right">Mevcut Stok</MudTh>
                <MudTh Style="text-align:right">Devir Hızı</MudTh>
                <MudTh>Durum</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.StokAdi</MudTd>
                <MudTd Style="text-align:right">@context.SatisMiktari.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.MevcutStok.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.DevirHizi.ToString("N2")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.DevirHizi > 1 ? Color.Success : Color.Warning)">
                        @(context.DevirHizi > 1 ? "Hızlı" : "Yavaş")
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @code {
        private List<DevirAnaliz>? analizListesi;

        private async Task LoadData()
        {
            var stoklar = await DbService.GetStoklarAsync();
            var faturalar = await DbService.GetFaturalarAsync();
            var satislar = faturalar.Where(f => f.Tur == "Satis" || f.Tur == "Satış").ToList();
            
            analizListesi = new List<DevirAnaliz>();

            foreach(var s in stoklar)
            {
                decimal toplamSatis = 0;
                // Bu stok için tüm fatura detaylarını tara (biraz maliyetli ama doğru sonuç)
                // Daha iyi performans için DatabaseService'e özel metod eklenebilir
                var detaylar = await DbService.GetStokHareketleriByStokIdAsync(s.Id);
                toplamSatis = detaylar.Where(h => h.IslemTuru == "ÇIKIŞ").Sum(h => h.Miktar);

                analizListesi.Add(new DevirAnaliz {
                    StokAdi = s.StokAdi ?? "",
                    SatisMiktari = toplamSatis,
                    MevcutStok = s.Miktar,
                    DevirHizi = s.Miktar > 0 ? (double)(toplamSatis / s.Miktar) : (toplamSatis > 0 ? 10 : 0)
                });
            }
            analizListesi = analizListesi.OrderByDescending(x => x.DevirHizi).ToList();
        }

        private async Task PrintReport()
        {
            if (analizListesi == null || !analizListesi.Any()) return;

            try
            {
                var headers = new[] { "Stok Adı", "Satış Miktarı", "Mevcut Stok", "Devir Hızı", "Durum" };
                var rows = analizListesi.Select(a => new[] 
                { 
                    a.StokAdi, 
                    a.SatisMiktari.ToString("N0"), 
                    a.MevcutStok.ToString("N0"),
                    a.DevirHizi.ToString("N2"),
                    a.DevirHizi > 1 ? "Hızlı" : "Yavaş"
                }).ToList();
                
                var pdf = await PdfService.GenerateGenericTablePdfBytesAsync("Stok Devir Hızı Raporu", headers, rows);
                await FileService.SaveAndOpenFileAsync("StokDevirRaporu.pdf", pdf, "application/pdf");
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
            }
        }

        class DevirAnaliz {
            public string StokAdi { get; set; } = "";
            public decimal SatisMiktari { get; set; }
            public decimal MevcutStok { get; set; }
            public double DevirHizi { get; set; }
        }
    }

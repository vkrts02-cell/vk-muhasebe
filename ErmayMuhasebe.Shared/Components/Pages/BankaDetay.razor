@page "/banka-detay/{Id:int}"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@using ErmayMuhasebe.Shared.Components.Dialogs
@inject DatabaseService DbService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IFileService FileService

<style>
    .banka-detail-container {
        padding: 24px;
        min-height: calc(100vh - 80px);
    }
    
    .banka-card {
        background: rgba(30, 34, 40, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

    .banka-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: linear-gradient(90deg, #3b82f6, #06b6d4);
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: white;
    }

    .stat-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.6);
    }

    .transaction-table .mud-table-cell {
        padding: 16px !important;
        border-bottom: 1px solid rgba(255,255,255,0.05) !important;
    }
    
    .transaction-row:hover {
        background-color: rgba(255,255,255,0.03) !important;
    }

    .amount-in { color: #34d399; font-weight: 700; }
    .amount-out { color: #f87171; font-weight: 700; }
    
    .action-chip {
        cursor: pointer;
        transition: all 0.2s;
    }
    .action-chip:hover {
        transform: translateY(-1px);
        filter: brightness(1.1);
    }
</style>

<div class="banka-detail-container">
    <div class="d-flex align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(() => Nav.NavigateTo("/finans"))" />
        <MudText Typo="Typo.h5" Class="font-weight-bold">Banka Hesap Detayı</MudText>
    </div>

    @if (banka == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <!-- INFO CARD -->
        <div class="banka-card">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <div class="d-flex align-center gap-4">
                         <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Rounded="true">
                             <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Medium" />
                         </MudAvatar>
                         <div>
                             <MudText Typo="Typo.h4" Class="font-weight-bold">@banka.BankaAdi</MudText>
                             <MudText Typo="Typo.body1" Style="opacity: 0.7; font-family: monospace;">@banka.IBAN</MudText>
                         </div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex justify-end align-center gap-8">
                    <div class="text-end">
                        <div class="stat-label">GÜNCEL BAKİYE</div>
                        <div class="stat-value">@banka.GuncelBakiye.ToString("N2") @banka.DovizTuru</div>
                    </div>
                     <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewTransaction">
                        Yeni İşlem Ekle
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>

        <!-- TRANSACTIONS -->
        <MudPaper Class="pa-4 glass-card" Elevation="0" Style="background: rgba(30, 34, 40, 0.4); backdrop-filter: blur(10px); border-radius: 16px; border: 1px solid rgba(255,255,255,0.05);">
            <div class="d-flex justify-space-between align-center mb-4 px-2">
                <MudText Typo="Typo.h6" Class="font-weight-bold">Hesap Hareketleri</MudText>
                <MudTextField @bind-Value="searchString" Placeholder="Ara..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mud-width-full" Style="max-width: 300px;" />
            </div>

            <MudTable Items="@transactions" Dense="true" Hover="true" Class="transaction-table" Elevation="0" Style="background: transparent;" Filter="new Func<BankaHareket,bool>(FilterFunc)">
                <HeaderContent>
                    <MudTh>Tarih</MudTh>
                    <MudTh>Açıklama / Kimden-Kime</MudTh>
                    <MudTh>İşlem Türü</MudTh>
                    <MudTh Style="text-align: right;">Giriş</MudTh>
                    <MudTh Style="text-align: right;">Çıkış</MudTh>
                    <MudTh Style="text-align: center;">Dekont</MudTh>
                    <MudTh Style="text-align: right;">İşlemler</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Tarih.ToString("dd.MM.yyyy")</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Aciklama</MudText>
                        @if (!string.IsNullOrEmpty(context.CariUnvan))
                        {
                            <MudText Typo="Typo.caption" Style="opacity: 0.6;">@context.CariUnvan</MudText>
                        }
                        @if (context.YonlendirilenCariId.HasValue)
                        {
                             <div class="d-flex align-center gap-1 mt-1">
                                 <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Info" style="font-size: 14px;" />
                                 <MudText Typo="Typo.caption" Color="Color.Info">Aktarıldı: @context.YonlendirilenCariUnvan</MudText>
                             </div>
                        }
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.IslemTuru == "Gelen Havale" ? Color.Success : Color.Error)" Variant="Variant.Outlined">@context.IslemTuru</MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        @if (context.Giren > 0)
                        {
                            <span class="amount-in">+@context.Giren.ToString("N2")</span>
                        }
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        @if (context.Cikan > 0)
                        {
                            <span class="amount-out">-@context.Cikan.ToString("N2")</span>
                        }
                    </MudTd>
                    <MudTd Style="text-align: center;">
                        @if (!string.IsNullOrEmpty(context.DekontPath))
                        {
                             <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ViewDekont(context.DekontPath))" title="Dekontu Görüntüle" />
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="opacity: 0.3;">-</MudText>
                        }
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        @if (context.Giren > 0 && context.YonlendirilenCariId == null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Send" OnClick="@(() => TransferTransaction(context))">Aktar (Tedarikçi)</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    
    private BankaKart? banka;
    private List<BankaHareket> transactions = new();
    private string searchString = "";
    private bool _isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var allBankas = await DbService.GetBankalarAsync();
        banka = allBankas.FirstOrDefault(b => b.Id == Id);
        
        if (banka != null)
        {
            var tr = await DbService.GetBankaHareketleriAsync(); // Need to filter by BankID logic which is effectively BankaAdi match in current generic schema or I need to add BankaId to Hareket properly
            // Re-checking BankaHareket model, it HAS BankaId.
            // But DbService.GetBankaHareketleriAsync() actually returns ALL or specific? I need to check implementation. 
            // The Razor file viewer for BankaHareketleri.razor showed fetching ALL.
            
            // I should fetch related transactions.
            // Note: Currently BankaHareket table usage might rely on BankaAdi or ID.
            
            // WORKAROUND: In current Database, if BankaId is populated, use it. If not, fallback to BankaAdi.
            // I will assume data is consistent.
            
            transactions = tr.Where(t => t.BankaId == Id || (t.BankaAdi == banka.BankaAdi)).OrderByDescending(t => t.Tarih).ToList();
        }
    }
    
    private bool FilterFunc(BankaHareket element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.Aciklama?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (element.CariUnvan?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (element.IslemTuru?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    private async Task OpenNewTransaction()
    {
        var parameters = new DialogParameters 
        { 
            ["Model"] = new BankaHareket { BankaId = Id, BankaAdi = banka?.BankaAdi, BankaKartId = Id }
        };
        
        var dialog = await DialogService.ShowAsync<BankaIslemDialog>("Yeni Banka İşlemi", parameters);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled && result.Data is BankaIslemDialog.BankaIslemResult res)
        {
            res.BankaHareket.CariId = res.CariId; // Ensure CariId is set for automatic linking
            await SaveTransaction(res.BankaHareket, res.CariId);
        }
    }
    
    private async Task SaveTransaction(BankaHareket model, int? cariId)
    {
        if (_isBusy) return;
        try 
        {
            _isBusy = true;
            StateHasChanged();
            
            // 1. Generate Shared EvrakNo if not present
            if (string.IsNullOrEmpty(model.EvrakNo) || model.EvrakNo == "-")
                model.EvrakNo = "BNK-" + DateTime.Now.Ticks.ToString().Substring(10);

            if (model.IslemTuru == "Gelen Havale")
            {
                model.Giren = model.Tutar;
                model.Cikan = 0;
            }
            else
            {
                model.Giren = 0;
                model.Cikan = model.Tutar;
            }

            await DbService.SaveBankaHareketAsync(model); 
        // DatabaseService helper check: 
        // It has Generic _db.InsertAsync/UpdateAsync. It does NOT have specific SaveBankaHareketAsync helper visible in snippet (it has aliases).
        // I'll use generic _db or add helper. 
        // Wait, for BankaHareket modification I need to update Banka Balance too!
        
        if (banka != null)
        {
            banka.GuncelBakiye += (model.Giren - model.Cikan);
            await DbService.SaveBankaKartAsync(banka); // Check if exists. Yes SaveCariKartAsync exists, SaveBankaKartAsync likely exists or I use generic.
            // Actually I checked DatabaseService, I didn't see SaveBankaKartAsync explicitly in the first viewing (it scrolled).
            // But I saw `await _db.CreateTableAsync<BankaKart>();`
            // I will assume I can use `_db.UpdateAsync` via a helper or I'll implement a helper in Code block if missing.
            // Actually, I should check if `DbService` exposes `GetConnection()`. 
            // It does: `public SQLiteAsyncConnection GetConnection()`
        }
        
        await LoadData();
        Snackbar.Add("İşlem başarıyla kaydedildi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Hata: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }
    
    private async Task TransferTransaction(BankaHareket source)
    {
        // Select Supplier
        var dialog = await DialogService.ShowAsync<CariSecDialog>("Aktarılacak Tedarikçiyi Seç");
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled && result.Data is CariKart supplier)
        {
             // Create Outgoing Transaction
             var outgoing = new BankaHareket
             {
                 BankaId = source.BankaId,
                 BankaAdi = source.BankaAdi,
                 IBAN = source.IBAN,
                 Tarih = DateTime.Now,
                 IslemTuru = "Giden Havale (Aktarım)",
                 Aciklama = $"Aktarım: {source.Aciklama} -> {supplier.Unvan}",
                 Tutar = source.Tutar, // Assuming full amount transfer
                 CariUnvan = supplier.Unvan,
                 DekontPath = source.DekontPath // Carry over attachment?
             };
             
             // Update Source
             source.Durum = "Yönlendirildi";
             source.YonlendirilenCariId = supplier.Id;
             source.YonlendirilenCariUnvan = supplier.Unvan;
             source.YonlendirmeTarihi = source.Tarih;
             
             // Save Outgoing (which updates balance and Cari)
             await SaveTransaction(outgoing, supplier.Id);
             
             // Check if SaveTransaction handles Generic Update of Source? No, I need to update Source manually.
             var db = DbService.GetConnection();
             await db.UpdateAsync(source);
             
             await LoadData();
             Snackbar.Add($"Tutar {supplier.Unvan} hesabına aktarıldı.", Severity.Success);
        }
    }
    
    private void ViewDekont(string path)
    {
        // Logic to open file. 
        // Since it's web/hybrid, opening local file path might be blocked by browser sandbox if not served.
        // But in Maui Blazor, it might work if we use Launcher.
        // Or if simple IFrame preview.
        // For now, I'll attempt to use FileService to "Open" it if possible or just show path?
        // User asked "dekont ekleyebileyim".
        // I'll assume standard file opening.
        try {
             System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path) { UseShellExecute = true });
        } catch {}
    }
}
